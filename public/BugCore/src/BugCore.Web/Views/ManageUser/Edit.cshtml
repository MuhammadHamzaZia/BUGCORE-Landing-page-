@model BugCore.Web.ViewModels.ManageUser.EditUserViewModel
@using BugCore.Core.Enums

@{
    ViewData["Title"] = "Edit User - BugCoreBT";
}

<div class="container py-4 max-w-2xl">
    <div class="mb-4">
        <a asp-action="Index" class="text-emerald-400 text-decoration-none small">
            <i class="bi bi-arrow-left me-1"></i> Back to User List
        </a>
        <h2 class="fw-bold mt-2"><i class="bi bi-pencil-square me-2"></i>Edit User Account</h2>
    </div>

    <div class="card bg-slate-900 border-slate-800 shadow">
        <div class="card-body p-4">
            <form method="post" asp-action="Edit">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="UserName" class="form-label fw-semibold text-slate-300">Username *</label>
                    <input asp-for="UserName" class="form-control bg-slate-800 border-slate-700 text-slate-100" required readonly="@Model.Protected" />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="RealName" class="form-label fw-semibold text-slate-300">Real Name</label>
                    <input asp-for="RealName" class="form-control bg-slate-800 border-slate-700 text-slate-100" />
                    <span asp-validation-for="RealName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold text-slate-300">Email Address</label>
                    <input asp-for="Email" type="email" class="form-control bg-slate-800 border-slate-700 text-slate-100" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AccessLevel" class="form-label fw-semibold text-slate-300">Global Access Level *</label>
                    <select asp-for="AccessLevel" class="form-select bg-slate-800 border-slate-700 text-slate-100" asp-items="Html.GetEnumSelectList<AccessLevel>()"></select>
                    <span asp-validation-for="AccessLevel" class="text-danger small"></span>
                </div>

                <div class="row mb-4">
                    <div class="col-6">
                        <div class="form-check form-switch">
                            <input asp-for="Enabled" class="form-check-input" type="checkbox" id="flexSwitchEnabled">
                            <label class="form-check-label text-slate-300" for="flexSwitchEnabled">Enabled Account</label>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-check form-switch">
                            <input asp-for="Protected" class="form-check-input" type="checkbox" id="flexSwitchProtected">
                            <label class="form-check-label text-slate-300" for="flexSwitchProtected">Protected Account</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary text-slate-300 px-4">Cancel</a>
                    <button type="submit" class="btn btn-success text-white fw-bold px-4 shadow"><i class="bi bi-check-circle-fill me-1"></i> Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
