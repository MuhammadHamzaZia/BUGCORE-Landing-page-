@model BugCore.Web.ViewModels.ManageUser.UserListViewModel
@using BugCore.Core.Enums

@{
    ViewData["Title"] = "Manage Users - BugCoreBT";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-people me-2"></i>Manage Users</h2>
            <p class="text-muted small mb-0">BugCoreBT User Account Administration & Access Control</p>
        </div>
        <a asp-action="Create" class="btn btn-emerald text-white px-3 fw-semibold">
            <i class="bi bi-person-plus-fill me-1"></i> Create New User
        </a>
    </div>

    <!-- Filter Bar -->
    <div class="card bg-slate-900 border-slate-800 mb-4 shadow-sm">
        <div class="card-body py-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-slate-800 border-slate-700 text-slate-400">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="search" class="form-control bg-slate-800 border-slate-700 text-slate-200" 
                               placeholder="Search by username, real name or email..." value="@Model.SearchQuery" />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="accessLevel" class="form-select bg-slate-800 border-slate-700 text-slate-200" asp-items="Html.GetEnumSelectList<AccessLevel>()">
                        <option value="">-- All Access Levels --</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-slate-700 text-slate-200 w-100 fw-semibold">Filter Users</button>
                    <a asp-action="Index" class="btn btn-outline-slate-700 text-slate-400">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- User Table -->
    <div class="card bg-slate-900 border-slate-800 shadow">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr class="border-bottom border-slate-800 text-slate-400 text-uppercase fs-7">
                        <th>Username</th>
                        <th>Real Name</th>
                        <th>Email</th>
                        <th>Access Level</th>
                        <th>Enabled</th>
                        <th>Protected</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Users.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-slate-500">
                                <i class="bi bi-person-x fs-3 d-block mb-2"></i>
                                No user accounts matching the specified filter criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td class="fw-bold text-white">
                                    <i class="bi bi-person-badge text-emerald-400 me-2"></i>@user.UserName
                                </td>
                                <td>@(string.IsNullOrEmpty(user.RealName) ? "-" : user.RealName)</td>
                                <td>@(string.IsNullOrEmpty(user.Email) ? "-" : user.Email)</td>
                                <td>
                                    <span class="badge bg-slate-800 text-emerald-400 border border-slate-700 px-2 py-1">
                                        @user.GlobalAccessLevel
                                    </span>
                                </td>
                                <td>
                                    @if (user.Enabled)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Disabled</span>
                                    }
                                </td>
                                <td>
                                    @if (user.Protected)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Protected</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-500">No</span>
                                    }
                                </td>
                                <td class="text-slate-400 small">@user.DateCreated.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-slate-700 text-slate-300" title="Edit User">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        @if (!user.Protected)
                                        {
                                            <form method="post" asp-action="ResetPassword" asp-route-id="@user.Id" class="d-inline" onsubmit="return confirm('Reset password for @user.UserName?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-slate-700 text-warning" title="Reset Password">
                                                    <i class="bi bi-key"></i> Reset
                                                </button>
                                            </form>
                                            <form method="post" asp-action="Delete" asp-route-id="@user.Id" class="d-inline" onsubmit="return confirm('Delete user account @user.UserName permanently?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-slate-700 text-danger" title="Delete User">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
