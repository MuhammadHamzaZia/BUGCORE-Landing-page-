@using BugCore.Core.Entities
@using BugCore.Core.Enums
@using BugCore.Core.Interfaces
@{
    ViewData["Title"] = "Slack ChatOps Integration Hub";
    var settings = ViewBag.Settings as IDictionary<string, string> ?? new Dictionary<string, string>();
    var channels = ViewBag.Channels as IEnumerable<SlackChannelDto> ?? new List<SlackChannelDto>();
    var projects = ViewBag.Projects as IEnumerable<Project> ?? new List<Project>();
    var recentIssues = ViewBag.RecentIssues as IEnumerable<Issue> ?? new List<Issue>();
    bool isAdmin = ViewBag.IsAdmin ?? false;
    string currentSlackUserId = ViewBag.CurrentSlackUserId as string ?? "U0812345678";
    string currentSlackUsername = ViewBag.CurrentSlackUsername as string ?? "developer";
}

<div class="container-fluid py-3">
    <!-- Header Banner -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom border-slate-300">
        <div>
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-slack text-emerald-600 fs-2"></i>
                <div>
                    <h3 class="fw-bold mb-0 text-slate-900">My Slack ChatOps Workbench</h3>
                    <span class="text-slate-600 small fw-medium">Link Personal Slack Identity, Customize Alert Thresholds, & View Slash Commands</span>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge bg-cyan-900 text-cyan-200 border border-cyan-700 px-3 py-2">
                <i class="bi bi-person-check-fill me-1"></i> Developer Account
            </span>
            @if (isAdmin)
            {
                <a asp-action="Admin" class="btn btn-sm btn-purple-700 text-white fw-bold shadow-sm">
                    <i class="bi bi-shield-lock-fill me-1"></i> Switch to Admin Governance Portal
                </a>
            }
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Nav Tabs for Features -->
    <ul class="nav nav-pills mb-4 bg-slate-900 p-2 rounded-3 border border-slate-800" id="slackTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active text-white fw-semibold" id="tab-identity" data-bs-toggle="pill" data-bs-target="#panel-identity" type="button" role="tab">
                <i class="bi bi-person-bounding-box me-2 text-cyan-400"></i>Identity Binding & Alert Preferences
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link text-white fw-semibold" id="tab-commands" data-bs-toggle="pill" data-bs-target="#panel-commands" type="button" role="tab">
                <i class="bi bi-terminal me-2 text-amber-400"></i>ChatOps Slash Commands (/bug)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link text-white fw-semibold" id="tab-escalate" data-bs-toggle="pill" data-bs-target="#panel-escalate" type="button" role="tab">
                <i class="bi bi-box-arrow-up-right me-2 text-cyan-400"></i>Message Escalation
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link text-white fw-semibold" id="tab-thread" data-bs-toggle="pill" data-bs-target="#panel-thread" type="button" role="tab">
                <i class="bi bi-chat-left-dots me-2 text-amber-400"></i>Thread Triage Sync
            </button>
        </li>
    </ul>

    <div class="tab-content" id="slackTabsContent">
        <!-- TAB 0: USER IDENTITY BINDING & PERSONAL PREFERENCES -->
        <div class="tab-pane fade show active" id="panel-identity" role="tabpanel">
            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="card bg-slate-900 border-slate-800 text-slate-100 shadow">
                        <div class="card-header bg-slate-800 border-slate-700 py-3">
                            <h5 class="fw-bold text-white mb-0"><i class="bi bi-link-45deg me-2 text-cyan-400"></i>Self-Service Identity Binding (OAuth)</h5>
                            <small class="text-slate-400">Link your personal Slack profile ID to your BUGCORE user session.</small>
                        </div>
                        <div class="card-body p-4">
                            <form asp-controller="Slack" asp-action="BindIdentity" method="post">
                                @Html.AntiForgeryToken()
                                <div class="mb-3">
                                    <label class="form-label text-slate-300">Slack User ID (`U...` Member ID)</label>
                                    <input type="text" name="slackUserId" class="form-control bg-slate-800 border-slate-700 text-slate-100 font-monospace" value="@currentSlackUserId" placeholder="e.g. U0812345678" required />
                                    <small class="text-slate-400">Found in Slack Profile -> More Actions -> Copy Member ID.</small>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label text-slate-300">Slack Username</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-slate-800 border-slate-700 text-slate-400">@@</span>
                                        <input type="text" name="slackUsername" class="form-control bg-slate-800 border-slate-700 text-slate-100" value="@currentSlackUsername" placeholder="e.g. alex.dev" required />
                                    </div>
                                </div>
                                <div class="p-3 bg-slate-800 rounded-3 border border-slate-700 mb-3">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="fw-bold text-slate-200">Current Binding Status</span>
                                        <span class="badge bg-emerald-600 text-white"><i class="bi bi-check-circle me-1"></i> Bound</span>
                                    </div>
                                    <div class="small text-slate-300">
                                        BUGCORE Account: <strong>@User.Identity?.Name</strong><br/>
                                        Bound Slack ID: <code class="text-cyan-400">@currentSlackUserId</code><br/>
                                        Slack Display Handle: <strong class="text-emerald-400">@@@currentSlackUsername</strong>
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-cyan text-white fw-bold w-100">
                                    <i class="bi bi-save me-1"></i> Update Slack Identity Link
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="card bg-slate-900 border-slate-800 text-slate-100 shadow h-100">
                        <div class="card-header bg-slate-800 border-slate-700 py-3">
                            <h5 class="fw-bold text-white mb-0"><i class="bi bi-sliders me-2 text-emerald-400"></i>Personal Notification Thresholds</h5>
                            <small class="text-slate-400">Customize personal alert rules to minimize disruptive context switching.</small>
                        </div>
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="prefMuteTrivial" checked>
                                    <label class="form-check-label text-slate-200" for="prefMuteTrivial">
                                        <strong>Mute Trivial Updates:</strong> Suppress Slack DMs for low-priority / minor bug status edits.
                                    </label>
                                </div>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="prefAssignOnly" checked>
                                    <label class="form-check-label text-slate-200" for="prefAssignOnly">
                                        <strong>Direct Assignment Alerts:</strong> Receive immediate Slack notifications when assigned as Handler.
                                    </label>
                                </div>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="prefSyncThreads" checked>
                                    <label class="form-check-label text-slate-200" for="prefSyncThreads">
                                        <strong>Thread Reply Auto-Sync:</strong> Save Slack thread replies underneath defect cards as internal IssueNotes.
                                    </label>
                                </div>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="prefCriticalOnly">
                                    <label class="form-check-label text-slate-200" for="prefCriticalOnly">
                                        <strong>Critical / Major Only:</strong> Only notify on defects with Major or Blocker severity.
                                    </label>
                                </div>
                            </div>
                            <div class="p-3 bg-slate-800 rounded-3 border border-slate-700">
                                <div class="small text-slate-300">
                                    <i class="bi bi-info-circle text-cyan-400 me-1"></i> These settings control your personal Slack alert frequency without affecting project-wide channel feeds configured by Administrators.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- CHATOPS SLASH COMMANDS GUIDE -->
        <div class="tab-pane fade" id="panel-commands" role="tabpanel">
            <div class="card bg-slate-900 border-slate-800 shadow mb-4 text-slate-100">
                <div class="card-header bg-slate-800 border-slate-700 py-3">
                    <h5 class="fw-bold text-white mb-1"><i class="bi bi-terminal text-amber-400 me-2"></i>Interactive ChatOps Slash Commands Reference</h5>
                    <p class="text-slate-400 small mb-0">Run these commands directly in any Slack channel or DM to manage BUGCORE defects.</p>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-slate-800 rounded-3 border border-slate-700 h-100">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge bg-amber-500 text-dark font-monospace fs-6">/bug create [summary]</span>
                                    <span class="badge bg-slate-700 text-slate-300">Reporter+</span>
                                </div>
                                <p class="small text-slate-300 mb-2">Creates a new defect ticket in BUGCORE under your linked profile.</p>
                                <div class="p-2 bg-slate-900 rounded font-monospace text-slate-400 small">
                                    Example: <code>/bug create Auth token expires prematurely on refresh</code>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-slate-800 rounded-3 border border-slate-700 h-100">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge bg-amber-500 text-dark font-monospace fs-6">/bug search [keyword]</span>
                                    <span class="badge bg-slate-700 text-slate-300">Viewer+</span>
                                </div>
                                <p class="small text-slate-300 mb-2">Searches for matching defects across all accessible projects and displays interactive summary cards.</p>
                                <div class="p-2 bg-slate-900 rounded font-monospace text-slate-400 small">
                                    Example: <code>/bug search auth</code>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-slate-800 rounded-3 border border-slate-700 h-100">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge bg-amber-500 text-dark font-monospace fs-6">/bug my-tickets</span>
                                    <span class="badge bg-slate-700 text-slate-300">Developer+</span>
                                </div>
                                <p class="small text-slate-300 mb-2">Lists all open defect tickets currently assigned to your account as Handler.</p>
                                <div class="p-2 bg-slate-900 rounded font-monospace text-slate-400 small">
                                    Example: <code>/bug my-tickets</code>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-slate-800 rounded-3 border border-slate-700 h-100">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge bg-amber-500 text-dark font-monospace fs-6">/bug resolve [id]</span>
                                    <span class="badge bg-slate-700 text-slate-300">Developer+</span>
                                </div>
                                <p class="small text-slate-300 mb-2">Marks a defect as resolved in BUGCORE. Permission checks apply on target project.</p>
                                <div class="p-2 bg-slate-900 rounded font-monospace text-slate-400 small">
                                    Example: <code>/bug resolve 102</code>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- FEATURE 2: MESSAGE-TO-TICKET ESCALATION -->
        <div class="tab-pane fade" id="panel-escalate" role="tabpanel">
            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="card bg-slate-900 border-slate-800 shadow h-100">
                        <div class="card-header bg-slate-800 border-slate-700 py-3">
                            <h5 class="fw-bold text-white mb-1"><i class="bi bi-chat-square-text text-cyan-400 me-2"></i>Slack Message Simulator</h5>
                            <span class="text-slate-400 small">Simulate clicking "Escalate to Tracker" from Slack's "More Actions" menu on any message.</span>
                        </div>
                        <div class="card-body p-4">
                            <div class="mb-3">
                                <label class="form-label text-slate-300 fw-semibold">Slack User Context</label>
                                <select id="escSlackUser" class="form-select bg-slate-800 border-slate-700 text-slate-100">
                                    <option value="U987654|alex.rivera">Alex Rivera (Manager)</option>
                                    <option value="U123456|marcus.vance" selected>Marcus Vance (Developer)</option>
                                    <option value="U555888|elena.rostova">Elena Rostova (Reporter)</option>
                                    <option value="U000111|marketing.sam">Sam Taylor (Viewer / Marketing)</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-slate-300 fw-semibold">Sample Slack Chat Message / Error Log</label>
                                <textarea id="escMessageText" class="form-control bg-slate-800 border-slate-700 text-slate-100 font-monospace small" rows="5">Uncaught TypeError: Cannot read properties of undefined (reading 'userId') at AuthProvider.js:148
  at async handleTokenRefresh (SessionManager.js:92)</textarea>
                            </div>

                            <button id="btnOpenModalSim" class="btn btn-cyan text-dark fw-bold w-100 shadow">
                                <i class="bi bi-lightning-charge-fill me-1"></i> Trigger "Escalate to Tracker" Action
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <!-- Native Slack Modal Popup Simulation -->
                    <div class="card bg-slate-900 border-cyan-500 shadow h-100">
                        <div class="card-header bg-slate-800 border-slate-700 py-3 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-window-sidebar text-cyan-400"></i>
                                <h6 class="fw-bold text-white mb-0">Native Slack Modal Response (API Output)</h6>
                            </div>
                            <span class="badge bg-cyan text-dark fw-bold">Slack Modal API</span>
                        </div>
                        <div class="card-body p-4">
                            <form id="escModalForm">
                                <div class="mb-3">
                                    <label class="form-label text-slate-300 fw-semibold">Target Project *</label>
                                    <select id="modalProjectId" class="form-select bg-slate-800 border-slate-700 text-slate-100" required>
                                        @foreach (var p in projects)
                                        {
                                            <option value="@p.Id">@p.Name (@(p.SlackChannelName ?? "#bugs-triage"))</option>
                                        }
                                    </select>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-6">
                                        <label class="form-label text-slate-300 fw-semibold">Severity</label>
                                        <select id="modalSeverity" class="form-select bg-slate-800 border-slate-700 text-slate-100">
                                            <option value="Minor">Minor</option>
                                            <option value="Major">Major</option>
                                            <option value="Crash" selected>Crash</option>
                                            <option value="Block">Block</option>
                                        </select>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label text-slate-300 fw-semibold">Priority</label>
                                        <select id="modalPriority" class="form-select bg-slate-800 border-slate-700 text-slate-100">
                                            <option value="Low">Low</option>
                                            <option value="Normal">Normal</option>
                                            <option value="High" selected>High</option>
                                            <option value="Urgent">Urgent</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label text-slate-300 fw-semibold">Issue Summary</label>
                                    <input type="text" id="modalSummary" class="form-control bg-slate-800 border-slate-700 text-slate-100" value="NullReferenceException in AuthProvider.js token refresh" required />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label text-slate-300 fw-semibold">Description (Pre-filled from Slack)</label>
                                    <textarea id="modalDescription" class="form-control bg-slate-800 border-slate-700 text-slate-100 font-monospace small" rows="3"></textarea>
                                </div>

                                <button type="submit" class="btn btn-emerald text-white fw-bold w-100 shadow">
                                    <i class="bi bi-check-circle-fill me-1"></i> Submit Modal & Generate Ticket
                                </button>
                            </form>

                            <div id="escResultAlert" class="mt-3 d-none alert alert-success py-2 small"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- FEATURE 3: SYNCHRONIZED THREAD TRIAGE -->
        <div class="tab-pane fade" id="panel-thread" role="tabpanel">
            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="card bg-slate-900 border-slate-800 shadow">
                        <div class="card-header bg-slate-800 border-slate-700 py-3">
                            <h5 class="fw-bold text-white mb-1"><i class="bi bi-chat-left-text text-amber-400 me-2"></i>Slack Thread Discussion Simulator</h5>
                            <span class="text-slate-400 small">Replies posted in a Slack defect thread are automatically captured into the BUGCORE database as IssueNotes.</span>
                        </div>
                        <div class="card-body p-4">
                            <div class="mb-3">
                                <label class="form-label text-slate-300 fw-semibold">Select Bug Ticket</label>
                                <select id="threadIssueId" class="form-select bg-slate-800 border-slate-700 text-slate-100">
                                    @foreach (var issue in recentIssues)
                                    {
                                        <option value="@issue.Id">Bug #@issue.Id: @issue.Summary (@issue.Project?.Name)</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-slate-300 fw-semibold">Slack User Replying</label>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <input type="text" id="threadSlackUserId" class="form-control bg-slate-800 border-slate-700 text-slate-100" value="U123456" />
                                    </div>
                                    <div class="col-6">
                                        <input type="text" id="threadSlackUserName" class="form-control bg-slate-800 border-slate-700 text-slate-100" value="marcus.vance" />
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-slate-300 fw-semibold">Thread Reply Text in Slack</label>
                                <textarea id="threadReplyText" class="form-control bg-slate-800 border-slate-700 text-slate-100" rows="3" placeholder="e.g. Root cause identified: null check missing in handleTokenRefresh. PR submitted!">Root cause identified: null check missing in handleTokenRefresh. PR submitted to main!</textarea>
                            </div>

                            <button id="btnSimulateThreadReply" class="btn btn-warning text-dark fw-bold w-100 shadow">
                                <i class="bi bi-arrow-repeat me-1"></i> Post Reply in Slack Thread & Sync to Database
                            </button>

                            <div id="threadResultAlert" class="mt-3 d-none alert alert-info py-2 small"></div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="card bg-slate-900 border-slate-800 shadow h-100">
                        <div class="card-header bg-slate-800 border-slate-700 py-3 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold text-white mb-0"><i class="bi bi-database-check text-emerald-400 me-2"></i>Live Database IssueNote View</h6>
                            <span class="badge bg-emerald-600 text-white">Auto-Synced</span>
                        </div>
                        <div class="card-body p-4" id="threadSyncDisplay">
                            <p class="text-slate-400 small">Select a bug ticket on the left and post a thread reply to see it sync instantly into BUGCORE's IssueNote table.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ENDPOINTS & WEBHOOKS -->
        <div class="tab-pane fade" id="panel-webhooks" role="tabpanel">
            <div class="card bg-slate-900 border-slate-800 shadow">
                <div class="card-header bg-slate-800 border-slate-700 py-3">
                    <h5 class="fw-bold text-white mb-1"><i class="bi bi-link-45deg text-indigo-400 me-2"></i>Slack App Webhook Endpoints</h5>
                    <span class="text-slate-400 small">Configure these URLs in your Slack App manifest / API settings portal.</span>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <label class="form-label text-slate-300 fw-bold">1. Event Subscriptions URL (Thread Discussion Sync)</label>
                        <input type="text" class="form-control bg-slate-800 border-slate-700 text-emerald-400 font-monospace" value="https://[YOUR-DOMAIN]/api/slack/events" readonly />
                        <span class="text-slate-400 small">Subscribe to bot event: <code class="text-slate-300">message.channels</code></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-slate-300 fw-bold">2. Interactivity & Shortcuts Request URL (Escalation Modals & Action Buttons)</label>
                        <input type="text" class="form-control bg-slate-800 border-slate-700 text-cyan-400 font-monospace" value="https://[YOUR-DOMAIN]/api/slack/interactions" readonly />
                        <span class="text-slate-400 small">Handles shortcuts, view submissions, and interactive card buttons.</span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-slate-300 fw-bold">3. Slash Commands Request URL (/bug, /escalate)</label>
                        <input type="text" class="form-control bg-slate-800 border-slate-700 text-amber-400 font-monospace" value="https://[YOUR-DOMAIN]/api/slack/commands" readonly />
                        <span class="text-slate-400 small">Configured command: <code class="text-slate-300">/bug [summary] - [description]</code></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Bot Config -->
<div class="modal fade" id="settingsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content bg-slate-900 border-slate-700 text-white">
            <div class="modal-header bg-slate-800 border-slate-700">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-shield-lock-fill text-purple-400 fs-4"></i>
                    <div>
                        <h5 class="modal-title fw-bold text-white mb-0">Slack Workspace Governance & Bot Settings</h5>
                        <small class="text-slate-400">Admin-Only Workspace Installation & Scope Approvals</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="SaveSettings" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    @if (!isAdmin)
                    {
                        <div class="alert alert-warning py-2 small mb-3">
                            <i class="bi bi-shield-exclamation me-1"></i> <strong>Admin Governance Notice:</strong> Only Workspace Owners or Administrators can update global OAuth tokens and Signing Secrets.
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label text-slate-300">Approved Bot User OAuth Token</label>
                        <input type="text" name="botToken" class="form-control bg-slate-800 border-slate-700 text-slate-100 font-monospace" value="@settings["BotToken"]" @(isAdmin ? "" : "readonly") required />
                        <small class="text-slate-400">Issued during workspace app installation under principle of least privilege.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-slate-300">Slack Signing Secret (HMAC-SHA256 Verification)</label>
                        <input type="password" name="signingSecret" class="form-control bg-slate-800 border-slate-700 text-slate-100 font-monospace" value="@settings["SigningSecret"]" @(isAdmin ? "" : "readonly") required />
                        <small class="text-slate-400">Used by `SlackRequestVerifier` to validate request signatures and reject replay attacks.</small>
                    </div>
                    
                    <div class="p-3 bg-slate-800 rounded-3 border border-slate-700 mb-3">
                        <h6 class="fw-bold text-slate-200 mb-2"><i class="bi bi-check-square me-1 text-emerald-400"></i>Vetted & Approved OAuth Scopes</h6>
                        <div class="row g-2 small text-slate-300">
                            <div class="col-md-6"><i class="bi bi-check2 text-emerald-400 me-1"></i> <code>chat:write</code> - Post interactive defect cards</div>
                            <div class="col-md-6"><i class="bi bi-check2 text-emerald-400 me-1"></i> <code>commands</code> - Custom `/bug` slash command</div>
                            <div class="col-md-6"><i class="bi bi-check2 text-emerald-400 me-1"></i> <code>channels:read</code> - Query public team channels</div>
                            <div class="col-md-6"><i class="bi bi-check2 text-emerald-400 me-1"></i> <code>im:write</code> - Direct DM notifications to developers</div>
                            <div class="col-md-6"><i class="bi bi-check2 text-emerald-400 me-1"></i> <code>users:read</code> - User profile & identity verification</div>
                            <div class="col-md-6"><i class="bi bi-check2 text-emerald-400 me-1"></i> <code>app_mentions:read</code> - Monitor thread reply events</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-slate-300">Default Outgoing Webhook URL</label>
                        <input type="url" name="webhookUrl" class="form-control bg-slate-800 border-slate-700 text-slate-100 font-monospace" value="@settings["WebhookUrl"]" @(isAdmin ? "" : "readonly") />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-slate-300">Fallback Triage Channel</label>
                        <input type="text" name="defaultChannel" class="form-control bg-slate-800 border-slate-700 text-slate-100" value="@settings["DefaultChannel"]" @(isAdmin ? "" : "readonly") required />
                    </div>
                </div>
                <div class="modal-footer bg-slate-800 border-slate-700">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    @if (isAdmin)
                    {
                        <button type="submit" class="btn btn-emerald text-white fw-bold">Save Workspace Settings</button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Feature 2 Simulator Script
        const btnOpenModalSim = document.getElementById("btnOpenModalSim");
        if (btnOpenModalSim) {
            btnOpenModalSim.addEventListener("click", function () {
                const msgText = document.getElementById("escMessageText").value;
                document.getElementById("modalDescription").value = msgText;
                let summary = msgText.split('\n')[0];
                if (summary.length > 70) summary = summary.substring(0, 67) + "...";
                document.getElementById("modalSummary").value = summary;
            });
        }

        const escModalForm = document.getElementById("escModalForm");
        if (escModalForm) {
            escModalForm.addEventListener("submit", function (e) {
                e.preventDefault();
                const userVal = document.getElementById("escSlackUser").value.split('|');
                const slackUserId = userVal[0];
                const slackUserName = userVal[1];

                const data = new FormData();
                data.append("projectId", document.getElementById("modalProjectId").value);
                data.append("summary", document.getElementById("modalSummary").value);
                data.append("description", document.getElementById("modalDescription").value);
                data.append("severity", document.getElementById("modalSeverity").value);
                data.append("priority", document.getElementById("modalPriority").value);
                data.append("slackUserId", slackUserId);
                data.append("slackUserName", slackUserName);

                fetch('/Slack/SimulateModalSubmit', {
                    method: 'POST',
                    body: data
                })
                .then(r => r.json())
                .then(res => {
                    const alertBox = document.getElementById("escResultAlert");
                    alertBox.classList.remove("d-none", "alert-danger", "alert-success");
                    if (res.success) {
                        alertBox.classList.add("alert-success");
                        alertBox.innerHTML = `<i class="bi bi-check-circle-fill me-2"></i> ${res.message} <a href="/Issue/Details/${res.issueId}" class="fw-bold text-dark ms-2" target="_blank">View Ticket #${res.issueId} &rarr;</a>`;
                    } else {
                        alertBox.classList.add("alert-danger");
                        alertBox.innerHTML = `<i class="bi bi-exclamation-triangle-fill me-2"></i> ${res.message}`;
                    }
                });
            });
        }

        // Feature 3 Simulator Script
        const btnSimulateThreadReply = document.getElementById("btnSimulateThreadReply");
        if (btnSimulateThreadReply) {
            btnSimulateThreadReply.addEventListener("click", function () {
                const issueId = document.getElementById("threadIssueId").value;
                const slackUserId = document.getElementById("threadSlackUserId").value;
                const slackUserName = document.getElementById("threadSlackUserName").value;
                const replyText = document.getElementById("threadReplyText").value;

                const data = new FormData();
                data.append("issueId", issueId);
                data.append("slackUserId", slackUserId);
                data.append("slackUserName", slackUserName);
                data.append("replyText", replyText);

                fetch('/Slack/SimulateThreadReply', {
                    method: 'POST',
                    body: data
                })
                .then(r => r.json())
                .then(res => {
                    const alertBox = document.getElementById("threadResultAlert");
                    alertBox.classList.remove("d-none");
                    if (res.success) {
                        alertBox.className = "mt-3 alert alert-success py-2 small";
                        alertBox.innerHTML = `<i class="bi bi-check-circle-fill me-2"></i> ${res.message} <a href="/Issue/Details/${issueId}" class="fw-bold text-dark ms-2" target="_blank">View Updated Bug #${issueId} &rarr;</a>`;
                        
                        document.getElementById("threadSyncDisplay").innerHTML = `
                            <div class="border border-emerald-500 bg-slate-800 p-3 rounded-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong class="text-white">${res.slackUserName}</strong>
                                    <span class="badge bg-emerald-600 text-white"><i class="bi bi-slack me-1"></i> Slack Thread Sync</span>
                                </div>
                                <p class="mb-0 text-slate-200 small">${res.noteText}</p>
                                <div class="text-slate-400 text-end small mt-2">Saved to IssueNote Table (ID: ${res.noteId})</div>
                            </div>
                        `;
                    } else {
                        alertBox.className = "mt-3 alert alert-danger py-2 small";
                        alertBox.innerText = res.message;
                    }
                });
            });
        }
    });
</script>
}
