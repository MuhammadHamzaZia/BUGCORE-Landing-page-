@using BugCore.Core.Entities
@using BugCore.Core.Enums
@using BugCore.Core.Interfaces
@{
    ViewData["Title"] = "Slack Admin Governance Portal";
    var settings = ViewBag.Settings as IDictionary<string, string> ?? new Dictionary<string, string>();
    var channels = ViewBag.Channels as IEnumerable<SlackChannelDto> ?? new List<SlackChannelDto>();
    var projects = ViewBag.Projects as IEnumerable<Project> ?? new List<Project>();
    string botToken = settings.TryGetValue("BotToken", out var bt) ? bt : "";
    string signingSecret = settings.TryGetValue("SigningSecret", out var ss) ? ss : "";
    string defaultChannel = settings.TryGetValue("DefaultChannel", out var dc) ? dc : "#bugs-triage";
}

<div class="container-fluid py-3">
    <!-- Header Banner -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom border-slate-300">
        <div>
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-lock-fill text-purple-600 fs-2"></i>
                <div>
                    <h3 class="fw-bold mb-0 text-slate-900">Slack ChatOps Admin Governance Portal</h3>
                    <span class="text-slate-600 small fw-medium">Workspace OAuth Tokens, Channel-to-Project Routing, and HMAC-SHA256 Security Compliance</span>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge bg-purple-900 text-purple-200 border border-purple-700 px-3 py-2">
                <i class="bi bi-shield-check me-1"></i> Admin Governance Mode
            </span>
            <a asp-action="Index" class="btn btn-sm btn-slate-800 text-slate-200">
                <i class="bi bi-person-workspace me-1"></i> Developer Workbench
            </a>
            <button class="btn btn-sm btn-emerald text-white fw-bold" data-bs-toggle="modal" data-bs-target="#settingsModal">
                <i class="bi bi-gear-fill me-1"></i> Configure Bot Credentials
            </button>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Admin Nav Tabs -->
    <ul class="nav nav-pills mb-4 bg-slate-900 p-2 rounded-3 border border-slate-800" id="adminSlackTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active text-white fw-semibold" id="tab-admin-routing" data-bs-toggle="pill" data-bs-target="#panel-admin-routing" type="button" role="tab">
                <i class="bi bi-diagram-3 me-2 text-emerald-400"></i>Project-Channel Routing Matrix
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link text-white fw-semibold" id="tab-admin-credentials" data-bs-toggle="pill" data-bs-target="#panel-admin-credentials" type="button" role="tab">
                <i class="bi bi-key me-2 text-amber-400"></i>Workspace OAuth & Bot Tokens
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link text-white fw-semibold" id="tab-admin-security" data-bs-toggle="pill" data-bs-target="#panel-admin-security" type="button" role="tab">
                <i class="bi bi-shield-check me-2 text-purple-400"></i>Webhook Audit & HMAC-SHA256
            </button>
        </li>
    </ul>

    <div class="tab-content" id="adminSlackTabsContent">
        <!-- PANEL 1: CHANNEL ROUTING MATRIX -->
        <div class="tab-pane fade show active" id="panel-admin-routing" role="tabpanel">
            <div class="card bg-slate-900 border-slate-800 text-slate-100 shadow">
                <div class="card-header bg-slate-800 border-slate-700 py-3">
                    <h5 class="fw-bold text-white mb-0"><i class="bi bi-diagram-3 me-2 text-emerald-400"></i>Central Project-to-Channel Broadcasting Matrix</h5>
                    <small class="text-slate-400">Map internal BUGCORE project defect broadcasts to target Slack channels.</small>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Slack" asp-action="SaveChannelRouting" method="post">
                        @Html.AntiForgeryToken()
                        <div class="table-responsive">
                            <table class="table table-dark table-hover align-middle border-slate-800">
                                <thead>
                                    <tr class="text-slate-400 small">
                                        <th>Internal Project Name</th>
                                        <th>Target Slack Channel</th>
                                        <th>Broadcasting Status</th>
                                        <th>Auto-Thread Escalation</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var proj in projects)
                                    {
                                        <tr>
                                            <td class="fw-bold text-white">@proj.Name</td>
                                            <td>
                                                <select name="channel_@proj.Id" class="form-select bg-slate-800 border-slate-700 text-slate-200 form-select-sm">
                                                    @foreach (var ch in channels)
                                                    {
                                                        <option value="@ch.Id">#@ch.Name (@ch.Id)</option>
                                                    }
                                                </select>
                                            </td>
                                            <td>
                                                <span class="badge bg-emerald-950 text-emerald-300 border border-emerald-700">Active Broadcasting</span>
                                            </td>
                                            <td>
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input bg-slate-800 border-slate-700" type="checkbox" checked />
                                                    <label class="form-check-label text-slate-300 small">Enabled</label>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-end mt-3">
                            <button type="submit" class="btn btn-emerald text-white fw-bold">
                                <i class="bi bi-check2-circle me-1"></i> Save Routing Matrix
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- PANEL 2: WORKSPACE OAUTH & BOT CREDENTIALS -->
        <div class="tab-pane fade" id="panel-admin-credentials" role="tabpanel">
            <div class="card bg-slate-900 border-slate-800 text-slate-100 shadow">
                <div class="card-header bg-slate-800 border-slate-700 py-3">
                    <h5 class="fw-bold text-white mb-0"><i class="bi bi-key me-2 text-amber-400"></i>Central Slack Application Credentials</h5>
                    <small class="text-slate-400">Stored securely for workspace-level broadcasting and API authentication.</small>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-slate-800 rounded-3 border border-slate-700 mb-3">
                                <label class="form-label text-slate-300 fw-bold">Bot User OAuth Token</label>
                                <input type="password" class="form-control bg-slate-900 border-slate-700 text-slate-100 font-monospace mb-2" value="@botToken" readonly />
                                <small class="text-slate-400">Grants permission to post rich Block Kit messages as the BUGCORE bot.</small>
                            </div>

                            <div class="p-3 bg-slate-800 rounded-3 border border-slate-700">
                                <label class="form-label text-slate-300 fw-bold">Slack App Signing Secret</label>
                                <input type="password" class="form-control bg-slate-900 border-slate-700 text-slate-100 font-monospace mb-2" value="@signingSecret" readonly />
                                <small class="text-slate-400">Used by `SlackRequestVerifier` for HMAC-SHA256 signature verification on incoming webhooks.</small>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-4 bg-purple-950 border border-purple-800 rounded-3 text-purple-200">
                                <h6 class="fw-bold text-white mb-2"><i class="bi bi-shield-check text-purple-400 me-2"></i>Approved Bot Scopes Checklist</h6>
                                <ul class="small mb-0 ps-3">
                                    <li><code class="text-amber-300">chat:write</code> - Post notifications & thread replies.</li>
                                    <li><code class="text-amber-300">commands</code> - Handle <code>/bug</code> slash command triggers.</li>
                                    <li><code class="text-amber-300">channels:read</code> - Discover public workspace channels.</li>
                                    <li><code class="text-amber-300">im:write</code> - Dispatch private ephemeral alerts to users.</li>
                                    <li><code class="text-amber-300">reactions:read</code> - Detect 🐛 & ✅ emoji escalations.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- PANEL 3: WEBHOOK AUDIT & HMAC SECURITY -->
        <div class="tab-pane fade" id="panel-admin-security" role="tabpanel">
            <div class="card bg-slate-900 border-slate-800 text-slate-100 shadow">
                <div class="card-header bg-slate-800 border-slate-700 py-3">
                    <h5 class="fw-bold text-white mb-0"><i class="bi bi-shield-check me-2 text-purple-400"></i>Webhook Endpoint Verification & Security Audit</h5>
                    <small class="text-slate-400">Real-time inspection of inbound request URLs and HMAC verification status.</small>
                </div>
                <div class="card-body p-4">
                    <div class="table-responsive">
                        <table class="table table-dark table-striped align-middle border-slate-800">
                            <thead>
                                <tr class="text-slate-400 small">
                                    <th>Slack Feature</th>
                                    <th>Required Inbound Request URL</th>
                                    <th>Security Protocol</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fw-bold">Event Subscriptions</td>
                                    <td><code class="text-cyan-400">https://[YOUR-HOST]/api/slack/events</code></td>
                                    <td>HMAC-SHA256 (300s Replay Protection)</td>
                                    <td><span class="badge bg-emerald-600">Active</span></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Interactive Components</td>
                                    <td><code class="text-cyan-400">https://[YOUR-HOST]/api/slack/interactive</code></td>
                                    <td>X-Slack-Signature Header Validation</td>
                                    <td><span class="badge bg-emerald-600">Active</span></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Slash Commands (`/bug`)</td>
                                    <td><code class="text-cyan-400">https://[YOUR-HOST]/api/slack/commands</code></td>
                                    <td>Token & Timestamp Matching</td>
                                    <td><span class="badge bg-emerald-600">Active</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Admin Bot Credentials -->
<div class="modal fade" id="settingsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-slate-900 text-slate-100 border-slate-800">
            <div class="modal-header border-slate-800">
                <h5 class="modal-title fw-bold text-white"><i class="bi bi-gear-fill me-2 text-emerald-400"></i>Update Slack Bot Credentials</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Slack" asp-action="SaveSettings" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-slate-300">Bot User OAuth Token</label>
                        <input type="text" name="botToken" class="form-control bg-slate-800 border-slate-700 text-slate-100 font-monospace" value="@botToken" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-slate-300">Signing Secret</label>
                        <input type="password" name="signingSecret" class="form-control bg-slate-800 border-slate-700 text-slate-100 font-monospace" value="@signingSecret" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-slate-300">Default Notification Channel</label>
                        <input type="text" name="defaultChannel" class="form-control bg-slate-800 border-slate-700 text-slate-100 font-monospace" value="@defaultChannel" placeholder="e.g. #bugs-triage" required />
                    </div>
                </div>
                <div class="modal-footer border-slate-800">
                    <button type="button" class="btn btn-slate-800 text-slate-300" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald text-white fw-bold">Save Workspace Settings</button>
                </div>
            </form>
        </div>
    </div>
</div>
