@model BugCore.Web.ViewModels.Projects.CategoryEditViewModel
@{
    ViewData["Title"] = $"Edit Category - {Model.Name}";
    var projectName = Model.Project != null ? Model.Project.Name : "Global (All Projects)";
}

<div class="container-fluid py-2" style="max-width: 800px;">
    <!-- Breadcrumb / Header -->
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <div>
            <h4 class="fw-bold mb-0 text-dark">
                <i class="bi bi-tag-fill me-2 text-primary"></i>Edit Category
            </h4>
            <span class="text-muted small">
                Belongs to: <strong>@projectName</strong>
            </span>
        </div>
        <div>
            @if (Model.ProjectId.HasValue && Model.ProjectId.Value > 0)
            {
                <a href="/Project/Edit/@Model.ProjectId#categories" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Project
                </a>
            }
            else
            {
                <a href="/Project/Index#categories" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Projects
                </a>
            }
        </div>
    </div>

    <!-- Edit Category Form (Mirroring manage_proj_cat_edit_page.php) -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom">
            <h6 class="mb-0 fw-bold text-dark">
                <i class="bi bi-pencil-square text-primary me-2"></i> Category Details
            </h6>
        </div>
        <div class="card-body p-4">
            <form asp-controller="Category" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ProjectId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                <!-- Category Name -->
                <div class="row mb-3 align-items-center">
                    <label asp-for="Name" class="col-sm-3 col-form-label fw-semibold text-secondary">
                        Category Name <span class="text-danger">*</span>
                    </label>
                    <div class="col-sm-9">
                        <input asp-for="Name" class="form-control" required maxlength="128" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Status -->
                <div class="row mb-3 align-items-center">
                    <label asp-for="Status" class="col-sm-3 col-form-label fw-semibold text-secondary">Status</label>
                    <div class="col-sm-9">
                        <select asp-for="Status" class="form-select">
                            <option value="0" selected="@(Model.Status == 0)">Enabled (Active for issue reporting)</option>
                            <option value="1" selected="@(Model.Status == 1)">Obsolete (Hidden from new issue reporting)</option>
                        </select>
                    </div>
                </div>

                <!-- Default Assignee -->
                <div class="row mb-4 align-items-center">
                    <label asp-for="DefaultAssigneeId" class="col-sm-3 col-form-label fw-semibold text-secondary">
                        Default Assignee
                    </label>
                    <div class="col-sm-9">
                        <select asp-for="DefaultAssigneeId" class="form-select">
                            <option value="">(None - leave issue unassigned)</option>
                            @foreach (var user in Model.AvailableUsers)
                            {
                                <option value="@user.Id" selected="@(Model.DefaultAssigneeId == user.Id)">
                                    @user.UserName (@(string.IsNullOrWhiteSpace(user.RealName) ? user.Email : user.RealName))
                                </option>
                            }
                        </select>
                        <span class="text-muted small">Issues created under this category will automatically be assigned to this user</span>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Action Buttons -->
                <div class="d-flex justify-content-between align-items-center">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Update Category
                    </button>
                    @if (Model.ProjectId.HasValue && Model.ProjectId.Value > 0)
                    {
                        <a href="/Project/Edit/@Model.ProjectId#categories" class="btn btn-outline-secondary">Cancel</a>
                    }
                    else
                    {
                        <a href="/Project/Index#categories" class="btn btn-outline-secondary">Cancel</a>
                    }
                </div>
            </form>
        </div>
    </div>
</div>
