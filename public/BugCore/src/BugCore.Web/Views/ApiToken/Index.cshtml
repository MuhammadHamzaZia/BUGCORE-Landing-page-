@model IEnumerable<BugCore.Core.Entities.ApiToken>
@using BugCore.Core.Entities
@{
    ViewData["Title"] = "Personal Access Tokens (PATs)";
    var projects = ViewBag.Projects as IEnumerable<Project> ?? new List<Project>();
    var newRawToken = TempData["NewRawToken"] as string;
    var newTokenName = TempData["NewTokenName"] as string;
    var newTokenExpiry = TempData["NewTokenExpiry"] as string;
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom border-slate-300">
        <div>
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-key-fill text-cyan-600 fs-2"></i>
                <div>
                    <h3 class="fw-bold mb-0 text-slate-900">Personal Access Tokens (PATs)</h3>
                    <span class="text-slate-600 small fw-medium">Manage bearer credentials for REST API calls, CI/CD pipelines, and automated scripts</span>
                </div>
            </div>
        </div>
        <div>
            <button type="button" class="btn btn-emerald fw-bold text-white shadow-sm" data-bs-toggle="modal" data-bs-target="#createTokenModal">
                <i class="bi bi-plus-circle me-1"></i> Generate New Token
            </button>
        </div>
    </div>

    <!-- ONE-TIME RAW TOKEN DISPLAY BANNER -->
    @if (!string.IsNullOrEmpty(newRawToken))
    {
        <div class="alert alert-warning bg-amber-950/80 border-amber-600 text-amber-200 p-4 rounded-3 shadow mb-4">
            <div class="d-flex align-items-start gap-3">
                <i class="bi bi-exclamation-triangle-fill text-amber-400 fs-2 mt-1"></i>
                <div class="w-100">
                    <h5 class="fw-bold text-amber-300 mb-1">Make sure to copy your new personal access token now!</h5>
                    <p class="small mb-3">
                        For security reasons, this raw token is hashed immediately and <strong>will never be shown to you again</strong>. If you lose it, you must revoke it and create a new one.
                    </p>
                    <div class="bg-slate-950 p-3 rounded border border-amber-700/60 d-flex justify-content-between align-items-center font-monospace">
                        <span class="text-amber-200 fs-6 select-all" id="rawTokenSpan">@newRawToken</span>
                        <button type="button" class="btn btn-sm btn-amber fw-bold" onclick="copyTokenToClipboard()">
                            <i class="bi bi-clipboard-check me-1"></i> Copy Token
                        </button>
                    </div>
                    <div class="mt-2 small text-slate-400">
                        Token Name: <strong class="text-white">@newTokenName</strong> | Expires At: <strong class="text-white">@newTokenExpiry</strong>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- TOKENS TABLE -->
    <div class="card bg-slate-900 border-slate-800 shadow">
        <div class="card-header bg-slate-850 border-slate-800 d-flex justify-content-between align-items-center py-3">
            <h6 class="fw-bold text-white mb-0">
                <i class="bi bi-shield-lock text-cyan-400 me-2"></i> Active & Historical Bearer Tokens
            </h6>
            <span class="badge bg-slate-800 text-slate-300 border border-slate-700">@Model.Count() Tokens Total</span>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="p-5 text-center text-slate-400">
                    <i class="bi bi-key text-slate-600 fs-1 d-block mb-3"></i>
                    <p class="mb-2">No personal access tokens generated yet.</p>
                    <button type="button" class="btn btn-sm btn-emerald text-white" data-bs-toggle="modal" data-bs-target="#createTokenModal">
                        Generate Your First PAT
                    </button>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0 border-slate-800">
                        <thead>
                            <tr class="text-slate-400 small text-uppercase bg-slate-950">
                                <th class="ps-4">Token Name & Scope</th>
                                <th>Project Bound</th>
                                <th>Created</th>
                                <th>Hard Expiration</th>
                                <th>Last Used Telemetry</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var token in Model)
                            {
                                bool isExpired = DateTime.UtcNow > token.ExpiresAt;
                                <tr class="@(token.IsRevoked || isExpired ? "opacity-60" : "")">
                                    <td class="ps-4 py-3">
                                        <div class="fw-bold text-white">@token.Name</div>
                                        <div class="d-flex align-items-center gap-2 mt-1">
                                            @if (token.IsRevoked)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle small">Revoked</span>
                                            }
                                            else if (isExpired)
                                            {
                                                <span class="badge bg-amber-950 text-amber-400 border border-amber-800 small">Expired</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-emerald-950 text-emerald-400 border border-emerald-800 small">Active</span>
                                            }

                                            <span class="badge bg-slate-800 text-cyan-300 border border-slate-700 font-monospace small">
                                                Scope: @token.Scope
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (token.Project != null)
                                        {
                                            <span class="text-slate-200"><i class="bi bi-folder2 text-emerald-400 me-1"></i>@token.Project.Name</span>
                                        }
                                        else
                                        {
                                            <span class="text-slate-500 italic">All Accessible Projects</span>
                                        }
                                    </td>
                                    <td class="small text-slate-400">
                                        @token.DateCreated.ToString("yyyy-MM-dd")
                                    </td>
                                    <td class="small">
                                        <span class="@(isExpired ? "text-amber-400 fw-bold" : "text-slate-300")">
                                            @token.ExpiresAt.ToString("yyyy-MM-dd HH:mm") UTC
                                        </span>
                                    </td>
                                    <td class="small">
                                        @if (token.DateUsed.HasValue)
                                        {
                                            <div class="text-slate-200">
                                                <i class="bi bi-clock-history me-1 text-cyan-400"></i>@token.DateUsed.Value.ToString("yyyy-MM-dd HH:mm")
                                            </div>
                                            <div class="text-slate-500 font-monospace small">
                                                IP: @(token.LastUsedIp ?? "127.0.0.1")
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-slate-500 italic">Never used</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (!token.IsRevoked)
                                        {
                                            <form asp-controller="ApiToken" asp-action="Revoke" method="post" class="d-inline" onsubmit="return confirm('Revoke token @token.Name? Any scripts using this credential will immediately fail.');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="tokenId" value="@token.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-slash-circle me-1"></i> Revoke
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-slate-600 small">Disabled</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- CREATE TOKEN MODAL -->
<div class="modal fade" id="createTokenModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-slate-900 text-white border-slate-800">
            <form asp-controller="ApiToken" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-slate-800">
                    <h5 class="modal-title fw-bold text-white">
                        <i class="bi bi-key-fill text-emerald-400 me-2"></i> Generate Personal Access Token
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label text-slate-300 small fw-bold">Token Name / Description</label>
                        <input type="text" name="name" class="form-control bg-slate-950 border-slate-800 text-white" placeholder="e.g. Jenkins CI/CD Release Pipeline" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-slate-300 small fw-bold">Granular Scope Limitation</label>
                        <select name="scope" class="form-select bg-slate-950 border-slate-800 text-white">
                            <option value="full_access" selected>Full REST API Access (Read & Write)</option>
                            <option value="read_only">Read-Only Access (Query Issues & Analytics)</option>
                            <option value="issue_write">Issue Creation & Note Posting Only</option>
                            <option value="project_restricted">Project Bound (Restricted Scope)</option>
                        </select>
                        <div class="form-text text-slate-500 small">Restricting scope prevents compromised external scripts from performing unauthorized actions.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-slate-300 small fw-bold">Target Project Restriction (Optional)</label>
                        <select name="projectId" class="form-select bg-slate-950 border-slate-800 text-white">
                            <option value="">-- All Accessible Projects --</option>
                            @foreach (var proj in projects)
                            {
                                <option value="@proj.Id">@proj.Name</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-slate-300 small fw-bold">Hard Expiration Window</label>
                        <select name="expiryDays" class="form-select bg-slate-950 border-slate-800 text-white">
                            <option value="30">30 Days (Recommended for Contractors)</option>
                            <option value="90" selected>90 Days (Standard Corporate Policy)</option>
                            <option value="180">180 Days (6 Months)</option>
                            <option value="365">365 Days (1 Year Maximum)</option>
                        </select>
                        <div class="form-text text-slate-500 small">Hard expiration prevents abandoned tokens from becoming long-term backdoors.</div>
                    </div>
                </div>
                <div class="modal-footer border-slate-800">
                    <button type="button" class="btn btn-slate-800 text-slate-300" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-emerald text-white fw-bold">
                        <i class="bi bi-shield-check me-1"></i> Generate Credential
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function copyTokenToClipboard() {
        const tokenText = document.getElementById('rawTokenSpan').innerText;
        navigator.clipboard.writeText(tokenText).then(() => {
            alert('Token copied to clipboard! Save it securely now.');
        });
    }
</script>
