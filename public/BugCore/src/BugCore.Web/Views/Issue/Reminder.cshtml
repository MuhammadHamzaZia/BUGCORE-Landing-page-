@model BugCore.Web.ViewModels.Issues.ReminderViewModel

@{
    ViewData["Title"] = $"Send Reminder for Issue #{Model.IssueId:D7} - BugCoreBT";
}

<div class="container py-4 max-w-2xl">
    <div class="mb-4">
        <a asp-action="Details" asp-route-id="@Model.IssueId" class="text-emerald-400 text-decoration-none small">
            <i class="bi bi-arrow-left me-1"></i> Back to Issue Details
        </a>
        <h2 class="fw-bold mt-2"><i class="bi bi-bell-fill me-2 text-warning"></i>Send Issue Reminder</h2>
        <p class="text-muted small mb-0">Issue #@Model.IssueId: @Model.Issue?.Summary</p>
    </div>

    <div class="card bg-slate-900 border-slate-800 shadow">
        <div class="card-body p-4">
            <form method="post" asp-action="Reminder">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IssueId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-slate-300">Recipient Users *</label>
                    <select asp-for="RecipientUserIds" class="form-select bg-slate-800 border-slate-700 text-slate-100" multiple size="5" required>
                        @foreach (var u in Model.AvailableUsers)
                        {
                            <option value="@u.Id">@u.UserName (@(string.IsNullOrEmpty(u.RealName) ? "User" : u.RealName))</option>
                        }
                    </select>
                    <small class="text-slate-500 d-block mt-1">Hold Ctrl/Cmd to select multiple recipients.</small>
                    <span asp-validation-for="RecipientUserIds" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ReminderText" class="form-label fw-semibold text-slate-300">Reminder Text *</label>
                    <textarea asp-for="ReminderText" class="form-control bg-slate-800 border-slate-700 text-slate-100" rows="4" placeholder="Enter reminder message or instructions..." required></textarea>
                    <span asp-validation-for="ReminderText" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Details" asp-route-id="@Model.IssueId" class="btn btn-slate-800 text-slate-300">Cancel</a>
                    <button type="submit" class="btn btn-warning text-dark fw-bold px-4">
                        <i class="bi bi-send-fill me-1"></i> Send Reminder
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
