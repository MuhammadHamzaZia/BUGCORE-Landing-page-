@model BugCore.Web.ViewModels.Issues.CreateIssueViewModel
@{
    ViewData["Title"] = "Enter Issue Details";
}

<div class="row justify-content-center">
    <div class="col-lg-11">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-pencil-square me-2 text-primary"></i> Enter Issue Details</h5>
                <span class="badge bg-light text-secondary border">BugCoreBT Issue Reporter</span>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <!-- Category & Reproducibility -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="ProjectId" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="ProjectId" class="form-select form-select-sm" onchange="location.href='@Url.Action("Create")?projectId=' + this.value">
                                @foreach (var p in Model.Projects)
                                {
                                    <option value="@p.Id" selected="@(p.Id == Model.ProjectId)">@p.Name</option>
                                }
                            </select>
                            <span asp-validation-for="ProjectId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="CategoryId" class="form-select form-select-sm">
                                <option value="">[ Select Category ]</option>
                                @foreach (var c in Model.Categories)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Reproducibility, Severity, Priority -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Reproducibility" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="Reproducibility" asp-items="Html.GetEnumSelectList<ReproducibilityType>()" class="form-select form-select-sm"></select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Severity" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="Severity" asp-items="Html.GetEnumSelectList<IssueSeverity>()" class="form-select form-select-sm"></select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Priority" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="Priority" asp-items="Html.GetEnumSelectList<IssuePriority>()" class="form-select form-select-sm"></select>
                        </div>
                    </div>

                    <!-- Assign To, Product Build, Target Version -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="HandlerId" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="HandlerId" class="form-select form-select-sm">
                                <option value="">[ Unassigned ]</option>
                                @foreach (var u in Model.Users)
                                {
                                    <option value="@u.Id">@(u.RealName ?? u.UserName)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Build" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Build" class="form-control form-control-sm" placeholder="e.g. v2.1.0-rc1" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="TargetVersion" class="form-label small fw-semibold text-secondary"></label>
                            @if (Model.Versions.Any())
                            {
                                <select asp-for="TargetVersion" class="form-select form-select-sm">
                                    <option value="">[ None ]</option>
                                    @foreach (var v in Model.Versions)
                                    {
                                        <option value="@v.Version">@v.Version</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input asp-for="TargetVersion" class="form-control form-control-sm" placeholder="Target Milestone / Release" />
                            }
                        </div>
                    </div>

                    <!-- Custom Fields (if linked to this project) -->
                    @if (Model.LinkedCustomFields.Any())
                    {
                        <div class="card card-body bg-light border-0 mb-3 py-2">
                            <h6 class="fw-bold small text-secondary mb-2"><i class="bi bi-tag me-1"></i> Project Custom Fields</h6>
                            <div class="row g-3">
                                @foreach (var link in Model.LinkedCustomFields)
                                {
                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold text-secondary">@link.CustomField.Name</label>
                                        <input type="text" name="CustomFields[@link.CustomFieldId]" class="form-control form-control-sm" value="@link.CustomField.DefaultValue" />
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Summary -->
                    <div class="mb-3">
                        <label asp-for="Summary" class="form-label small fw-semibold text-secondary"></label> <span class="text-danger">*</span>
                        <input asp-for="Summary" class="form-control" placeholder="Brief summary of the issue" />
                        <span asp-validation-for="Summary" class="text-danger small"></span>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label small fw-semibold text-secondary"></label> <span class="text-danger">*</span>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Comprehensive explanation of what occurred"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <!-- Steps to Reproduce -->
                    <div class="mb-3">
                        <label asp-for="StepsToReproduce" class="form-label small fw-semibold text-secondary"></label>
                        <textarea asp-for="StepsToReproduce" class="form-control" rows="3" placeholder="1. Navigate to...&#10;2. Click on...&#10;3. Observe crash or error..."></textarea>
                    </div>

                    <!-- Additional Information -->
                    <div class="mb-3">
                        <label asp-for="AdditionalInformation" class="form-label small fw-semibold text-secondary"></label>
                        <textarea asp-for="AdditionalInformation" class="form-control" rows="2" placeholder="Environment details, browser version, crash stack trace..."></textarea>
                    </div>

                    <!-- File Attachment (bug_file_add.php) -->
                    <div class="row g-3 mb-3 align-items-end">
                        <div class="col-md-6">
                            <label asp-for="Attachment" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Attachment" type="file" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AttachmentDescription" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="AttachmentDescription" class="form-control form-control-sm" placeholder="Optional description of attached screenshot or log" />
                        </div>
                    </div>

                    <!-- View Status -->
                    <div class="mb-4">
                        <label class="form-label small fw-semibold text-secondary d-block">View Status</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="ViewState" id="vsPublic" value="@ProjectViewState.Public" checked />
                            <label class="form-check-label small" for="vsPublic"><i class="bi bi-globe me-1 text-success"></i> Public</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="ViewState" id="vsPrivate" value="@ProjectViewState.Private" />
                            <label class="form-check-label small" for="vsPrivate"><i class="bi bi-lock me-1 text-danger"></i> Private</label>
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="d-flex justify-content-between border-top pt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary fw-semibold px-4">
                            <i class="bi bi-check-circle me-1"></i> Submit Report
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
