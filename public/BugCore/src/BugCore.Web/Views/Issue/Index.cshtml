@model BugCore.Web.ViewModels.Issues.IssueListViewModel
@{
    ViewData["Title"] = "View Issues";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-list-task me-2 text-primary"></i> View Issues</h4>
        <small class="text-muted">Filtered defect inventory and multi-column triage</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Report Issue
        </a>
    </div>
</div>

<!-- BUGCORE Multi-Column Filter Bar -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-light py-2 px-3 d-flex justify-content-between align-items-center">
        <span class="fw-bold small text-secondary"><i class="bi bi-funnel me-1"></i> Issue Filter Parameters</span>
        <button class="btn btn-link btn-sm text-decoration-none p-0 text-muted" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="true">
            <i class="bi bi-chevron-down"></i>
        </button>
    </div>
    <div class="collapse show" id="filterCollapse">
        <div class="card-body p-3 bg-white">
            <form method="get" asp-action="Index" id="filterForm">
                <input type="hidden" name="sortField" value="@Model.SortField" />
                <input type="hidden" name="sortDirection" value="@Model.SortDirection" />

                <div class="row g-2 mb-2">
                    <!-- Project Filter -->
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label small text-muted mb-1">Project</label>
                        <select name="projectId" class="form-select form-select-sm">
                            <option value="">[ All Projects ]</option>
                            @foreach (var p in Model.Projects)
                            {
                                <option value="@p.Id" selected="@(Model.ProjectId == p.Id)">@p.Name</option>
                            }
                        </select>
                    </div>

                    <!-- Category Filter -->
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label small text-muted mb-1">Category</label>
                        <select name="categoryId" class="form-select form-select-sm">
                            <option value="">[ Any Category ]</option>
                            @foreach (var c in Model.Categories)
                            {
                                <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                            }
                        </select>
                    </div>

                    <!-- Status Filter -->
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label small text-muted mb-1">Status</label>
                        <select name="status" class="form-select form-select-sm">
                            <option value="">[ Any Status ]</option>
                            @foreach (IssueStatus s in Enum.GetValues(typeof(IssueStatus)))
                            {
                                <option value="@s" selected="@(Model.Status == s)">@s</option>
                            }
                        </select>
                    </div>

                    <!-- Priority Filter -->
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label small text-muted mb-1">Priority</label>
                        <select name="priority" class="form-select form-select-sm">
                            <option value="">[ Any Priority ]</option>
                            @foreach (IssuePriority pr in Enum.GetValues(typeof(IssuePriority)))
                            {
                                <option value="@pr" selected="@(Model.Priority == pr)">@pr</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <!-- Severity Filter -->
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label small text-muted mb-1">Severity</label>
                        <select name="severity" class="form-select form-select-sm">
                            <option value="">[ Any Severity ]</option>
                            @foreach (IssueSeverity sv in Enum.GetValues(typeof(IssueSeverity)))
                            {
                                <option value="@sv" selected="@(Model.Severity == sv)">@sv</option>
                            }
                        </select>
                    </div>

                    <!-- Handler (Assigned To) Filter -->
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label small text-muted mb-1">Assigned To</label>
                        <select name="handlerId" class="form-select form-select-sm">
                            <option value="">[ Anyone ]</option>
                            <option value="0" selected="@(Model.HandlerId == 0)">[ None / Unassigned ]</option>
                            @foreach (var u in Model.Users)
                            {
                                <option value="@u.Id" selected="@(Model.HandlerId == u.Id)">@(u.RealName ?? u.UserName)</option>
                            }
                        </select>
                    </div>

                    <!-- Reporter Filter -->
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label small text-muted mb-1">Reporter</label>
                        <select name="reporterId" class="form-select form-select-sm">
                            <option value="">[ Any Reporter ]</option>
                            @foreach (var u in Model.Users)
                            {
                                <option value="@u.Id" selected="@(Model.ReporterId == u.Id)">@(u.RealName ?? u.UserName)</option>
                            }
                        </select>
                    </div>

                    <!-- Resolution Filter -->
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label small text-muted mb-1">Resolution</label>
                        <select name="resolution" class="form-select form-select-sm">
                            <option value="">[ Any Resolution ]</option>
                            @foreach (ResolutionType res in Enum.GetValues(typeof(ResolutionType)))
                            {
                                <option value="@res" selected="@(Model.Resolution == res)">@res</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row g-2 align-items-center">
                    <!-- Search Input -->
                    <div class="col-md-6 col-sm-12">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                            <input type="text" name="search" value="@Model.SearchQuery" placeholder="Search keywords in summary, description, reporter, handler..." class="form-control" />
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <select name="viewState" class="form-select form-select-sm">
                            <option value="">[ All View States ]</option>
                            <option value="@ProjectViewState.Public" selected="@(Model.ViewState == ProjectViewState.Public)">Public Only</option>
                            <option value="@ProjectViewState.Private" selected="@(Model.ViewState == ProjectViewState.Private)">Private Only</option>
                        </select>
                    </div>

                    <div class="col-md-3 col-sm-6 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
                            <i class="bi bi-funnel me-1"></i> Apply Filter
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">Reset</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Issues Table & Batch Action Group Form (bug_actiongroup_page.php) -->
<form asp-action="ActionGroup" method="post" id="actionGroupForm">
    @Html.AntiForgeryToken()

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light text-secondary">
                    <tr>
                        <th style="width: 35px;" class="text-center">
                            <input type="checkbox" id="selectAllCheckbox" class="form-check-input" />
                        </th>
                        <th style="width: 85px;">
                            <a href="@Url.Action("Index", new { sortField = "Id", sortDirection = (Model.SortField == "Id" && Model.SortDirection == "ASC" ? "DESC" : "ASC"), projectId = Model.ProjectId, status = Model.Status, search = Model.SearchQuery })" class="text-decoration-none text-dark fw-bold">
                                ID @(Model.SortField == "Id" ? (Model.SortDirection == "ASC" ? "▲" : "▼") : "")
                            </a>
                        </th>
                        <th>Project</th>
                        <th>Category</th>
                        <th style="width: 90px;">
                            <a href="@Url.Action("Index", new { sortField = "Severity", sortDirection = (Model.SortField == "Severity" && Model.SortDirection == "ASC" ? "DESC" : "ASC"), projectId = Model.ProjectId, status = Model.Status })" class="text-decoration-none text-dark fw-bold">
                                Severity @(Model.SortField == "Severity" ? (Model.SortDirection == "ASC" ? "▲" : "▼") : "")
                            </a>
                        </th>
                        <th style="width: 90px;">
                            <a href="@Url.Action("Index", new { sortField = "Priority", sortDirection = (Model.SortField == "Priority" && Model.SortDirection == "ASC" ? "DESC" : "ASC"), projectId = Model.ProjectId, status = Model.Status })" class="text-decoration-none text-dark fw-bold">
                                Priority @(Model.SortField == "Priority" ? (Model.SortDirection == "ASC" ? "▲" : "▼") : "")
                            </a>
                        </th>
                        <th style="width: 100px;">
                            <a href="@Url.Action("Index", new { sortField = "Status", sortDirection = (Model.SortField == "Status" && Model.SortDirection == "ASC" ? "DESC" : "ASC"), projectId = Model.ProjectId, status = Model.Status })" class="text-decoration-none text-dark fw-bold">
                                Status @(Model.SortField == "Status" ? (Model.SortDirection == "ASC" ? "▲" : "▼") : "")
                            </a>
                        </th>
                        <th>
                            <a href="@Url.Action("Index", new { sortField = "Summary", sortDirection = (Model.SortField == "Summary" && Model.SortDirection == "ASC" ? "DESC" : "ASC"), projectId = Model.ProjectId, status = Model.Status })" class="text-decoration-none text-dark fw-bold">
                                Summary @(Model.SortField == "Summary" ? (Model.SortDirection == "ASC" ? "▲" : "▼") : "")
                            </a>
                        </th>
                        <th>Handler</th>
                        <th style="width: 130px;">
                            <a href="@Url.Action("Index", new { sortField = "LastUpdated", sortDirection = (Model.SortField == "LastUpdated" && Model.SortDirection == "ASC" ? "DESC" : "ASC"), projectId = Model.ProjectId, status = Model.Status })" class="text-decoration-none text-dark fw-bold">
                                Updated @(Model.SortField == "LastUpdated" ? (Model.SortDirection == "ASC" ? "▲" : "▼") : "")
                            </a>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Issues.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2 text-secondary"></i>
                                No issues found matching the selected filter criteria.
                            </td>
                        </tr>
                    }
                    @foreach (var issue in Model.Issues)
                    {
                        var statusBg = issue.Status switch
                        {
                            IssueStatus.New => "bg-danger text-white",
                            IssueStatus.Feedback => "bg-warning text-dark",
                            IssueStatus.Acknowledged => "bg-info text-dark",
                            IssueStatus.Confirmed => "bg-primary text-white",
                            IssueStatus.Assigned => "bg-primary text-white",
                            IssueStatus.Resolved => "bg-success text-white",
                            IssueStatus.Closed => "bg-secondary text-white",
                            _ => "bg-light text-dark"
                        };

                        <tr>
                            <td class="text-center">
                                <input type="checkbox" name="selectedIssueIds" value="@issue.Id" class="form-check-input issue-select-checkbox" />
                            </td>
                            <td>
                                @if (issue.Sticky)
                                {
                                    <i class="bi bi-pin-angle-fill text-danger me-1" title="Sticky Issue"></i>
                                }
                                <a asp-action="Details" asp-route-id="@issue.Id" class="fw-bold font-monospace text-decoration-none">
                                    @issue.Id.ToString("D7")
                                </a>
                            </td>
                            <td><span class="badge bg-light text-dark border">@issue.Project?.Name</span></td>
                            <td>@(issue.Category?.Name ?? "General")</td>
                            <td><span class="badge bg-secondary-subtle text-dark border">@issue.Severity</span></td>
                            <td><span class="badge bg-light text-dark border">@issue.Priority</span></td>
                            <td><span class="badge @statusBg">@issue.Status</span></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@issue.Id" class="text-dark text-decoration-none fw-semibold">
                                    @issue.Summary
                                </a>
                                @if (issue.ViewState == ProjectViewState.Private)
                                {
                                    <i class="bi bi-lock-fill text-danger ms-1" title="Private issue"></i>
                                }
                                @if (issue.Tags.Any())
                                {
                                    @foreach (var it in issue.Tags)
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border ms-1 small">#@it.Tag.Name</span>
                                    }
                                }
                                @if (issue.Notes.Any())
                                {
                                    <span class="badge bg-light text-secondary border ms-1" title="@issue.Notes.Count notes">
                                        <i class="bi bi-chat-text me-1"></i>@issue.Notes.Count
                                    </span>
                                }
                                @if (issue.Attachments.Any())
                                {
                                    <span class="badge bg-light text-secondary border ms-1" title="@issue.Attachments.Count attachments">
                                        <i class="bi bi-paperclip me-1"></i>@issue.Attachments.Count
                                    </span>
                                }
                            </td>
                            <td>@(issue.Handler?.RealName ?? issue.Handler?.UserName ?? "Unassigned")</td>
                            <td class="text-muted text-nowrap">@issue.LastUpdated.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Footer with Batch Actions & Pagination -->
        <div class="card-footer bg-light p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <!-- Batch / Action Group Selector -->
            <div class="d-flex align-items-center gap-2">
                <span class="small text-secondary fw-semibold">With selected:</span>
                <select name="actionGroupType" class="form-select form-select-sm" style="width: 180px;">
                    <option value="status">Change Status</option>
                    <option value="assign">Assign</option>
                    <option value="priority">Change Priority</option>
                    <option value="severity">Change Severity</option>
                    <option value="viewstate">Change View Status</option>
                    <option value="move">Move to Project</option>
                    <option value="attach_tags">Attach Tags</option>
                    <option value="delete">Delete</option>
                </select>
                <button type="submit" class="btn btn-sm btn-dark px-3">OK</button>
            </div>

            <!-- Pagination Controls -->
            <div class="d-flex align-items-center gap-3">
                <span class="small text-muted">
                    Showing @Model.Issues.Count() of @Model.TotalCount issues
                </span>

                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Issue list pagination">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage - 1, projectId = Model.ProjectId, status = Model.Status, search = Model.SearchQuery, sortField = Model.SortField, sortDirection = Model.SortDirection })">Previous</a>
                            </li>

                            @for (int p = Math.Max(1, Model.CurrentPage - 2); p <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); p++)
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = p, projectId = Model.ProjectId, status = Model.Status, search = Model.SearchQuery, sortField = Model.SortField, sortDirection = Model.SortDirection })">@p</a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage + 1, projectId = Model.ProjectId, status = Model.Status, search = Model.SearchQuery, sortField = Model.SortField, sortDirection = Model.SortDirection })">Next</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</form>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const selectAll = document.getElementById('selectAllCheckbox');
        const checkboxes = document.querySelectorAll('.issue-select-checkbox');

        if (selectAll) {
            selectAll.addEventListener('change', function () {
                checkboxes.forEach(cb => cb.checked = selectAll.checked);
            });
        }
    });
</script>
