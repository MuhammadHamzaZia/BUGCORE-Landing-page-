@model BugCore.Web.ViewModels.Issues.IssueDetailsViewModel
@{
    ViewData["Title"] = $"Issue #{Model.Issue.Id:D7}: {Model.Issue.Summary}";
    var statusBg = Model.Issue.Status switch
    {
        IssueStatus.New => "bg-danger text-white",
        IssueStatus.Feedback => "bg-warning text-dark",
        IssueStatus.Acknowledged => "bg-info text-dark",
        IssueStatus.Confirmed => "bg-primary text-white",
        IssueStatus.Assigned => "bg-primary text-white",
        IssueStatus.Resolved => "bg-success text-white",
        IssueStatus.Closed => "bg-secondary text-white",
        _ => "bg-light text-dark"
    };
}

<!-- Page Header & Action Bar -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h4 class="fw-bold mb-0">
            <span class="text-secondary font-monospace">#@Model.Issue.Id.ToString("D7")</span>: @Model.Issue.Summary
        </h4>
        <small class="text-muted">
            Project: <strong class="text-dark">@Model.Issue.Project.Name</strong> |
            Category: <strong class="text-dark">@(Model.Issue.Category?.Name ?? "General")</strong> |
            Submitted: @Model.Issue.DateSubmitted.ToString("yyyy-MM-dd HH:mm")
        </small>
    </div>
    <div class="d-flex gap-2">
        @if (Model.CanUpdate)
        {
            <a asp-action="Edit" asp-route-id="@Model.Issue.Id" class="btn btn-sm btn-primary">
                <i class="bi bi-pencil-square me-1"></i> Edit Issue
            </a>
        }

        <!-- Toggle Monitor Button -->
        <form asp-action="ToggleMonitor" asp-route-id="@Model.Issue.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm @(Model.IsMonitored ? "btn-warning" : "btn-outline-secondary")">
                <i class="bi @(Model.IsMonitored ? "bi-eye-slash-fill" : "bi-eye") me-1"></i>
                @(Model.IsMonitored ? "End Monitoring" : "Monitor Issue")
            </button>
        </form>

        <!-- Toggle Sticky Button (bug_stick.php) -->
        <form asp-action="ToggleSticky" asp-route-id="@Model.Issue.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="sticky" value="@(Model.Issue.Sticky ? "false" : "true")" />
            <button type="submit" class="btn btn-sm @(Model.Issue.Sticky ? "btn-dark" : "btn-outline-dark")">
                <i class="bi @(Model.Issue.Sticky ? "bi-pin-angle-fill" : "bi-pin-angle") me-1"></i>
                @(Model.Issue.Sticky ? "Unstick Issue" : "Stick Issue")
            </button>
        </form>

        @if (Model.CanDelete)
        {
            <form asp-action="Delete" asp-route-id="@Model.Issue.Id" method="post" onsubmit="return confirm('Are you sure you want to permanently delete issue #@Model.Issue.Id.ToString("D7")?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-trash me-1"></i> Delete
                </button>
            </form>
        }

        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> View Issues
        </a>
    </div>
</div>

<!-- BugCoreBT Issue Properties Grid (bug_view_page.php) -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-light py-2 px-3 fw-bold small text-secondary d-flex justify-content-between align-items-center">
        <span><i class="bi bi-info-circle me-1"></i> Defect Properties</span>
        <span class="badge @statusBg">@Model.Issue.Status (@Model.Issue.Resolution)</span>
    </div>
    <div class="card-body p-0">
        <table class="table table-bordered table-sm mb-0 small">
            <tbody>
                <tr>
                    <th class="bg-light text-secondary" style="width: 15%;">Issue ID</th>
                    <td style="width: 35%;" class="font-monospace fw-bold">#@Model.Issue.Id.ToString("D7")</td>
                    <th class="bg-light text-secondary" style="width: 15%;">Project</th>
                    <td style="width: 35%;">@Model.Issue.Project.Name</td>
                </tr>
                <tr>
                    <th class="bg-light text-secondary">Category</th>
                    <td>@(Model.Issue.Category?.Name ?? "General")</td>
                    <th class="bg-light text-secondary">View Status</th>
                    <td>
                        @if (Model.Issue.ViewState == ProjectViewState.Private)
                        {
                            <span class="text-danger fw-semibold"><i class="bi bi-lock-fill me-1"></i> Private</span>
                        }
                        else
                        {
                            <span class="text-success"><i class="bi bi-globe me-1"></i> Public</span>
                        }
                    </td>
                </tr>
                <tr>
                    <th class="bg-light text-secondary">Date Submitted</th>
                    <td>@Model.Issue.DateSubmitted.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <th class="bg-light text-secondary">Last Updated</th>
                    <td>@Model.Issue.LastUpdated.ToString("yyyy-MM-dd HH:mm:ss")</td>
                </tr>
                <tr>
                    <th class="bg-light text-secondary">Reporter</th>
                    <td>
                        <strong class="text-dark">@(Model.Issue.Reporter?.RealName ?? Model.Issue.Reporter?.UserName)</strong>
                        <span class="text-muted">(@(Model.Issue.Reporter?.Email ?? "No email"))</span>
                    </td>
                    <th class="bg-light text-secondary">Assigned To</th>
                    <td>
                        @if (Model.CanAssign)
                        {
                            <form asp-action="Assign" asp-route-id="@Model.Issue.Id" method="post" class="d-flex gap-2">
                                @Html.AntiForgeryToken()
                                <select name="handlerId" class="form-select form-select-sm py-0" style="max-width: 200px;">
                                    <option value="">[ None / Unassigned ]</option>
                                    @foreach (var u in Model.AssignableUsers)
                                    {
                                        <option value="@u.Id" selected="@(Model.Issue.HandlerId == u.Id)">@(u.RealName ?? u.UserName)</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary py-0">Assign</button>
                            </form>
                        }
                        else
                        {
                            <span class="fw-semibold">@(Model.Issue.Handler?.RealName ?? Model.Issue.Handler?.UserName ?? "Unassigned")</span>
                        }
                    </td>
                </tr>
                <tr>
                    <th class="bg-light text-secondary">Priority</th>
                    <td><span class="badge bg-light text-dark border">@Model.Issue.Priority</span></td>
                    <th class="bg-light text-secondary">Severity</th>
                    <td><span class="badge bg-secondary">@Model.Issue.Severity</span></td>
                </tr>
                <tr>
                    <th class="bg-light text-secondary">Reproducibility</th>
                    <td>@Model.Issue.Reproducibility</td>
                    <th class="bg-light text-secondary">Resolution</th>
                    <td><span class="badge bg-light text-dark border">@Model.Issue.Resolution</span></td>
                </tr>
                <tr>
                    <th class="bg-light text-secondary">Target Version</th>
                    <td>@(string.IsNullOrWhiteSpace(Model.Issue.TargetVersion) ? "none" : Model.Issue.TargetVersion)</td>
                    <th class="bg-light text-secondary">Build</th>
                    <td>@(string.IsNullOrWhiteSpace(Model.Issue.Build) ? "none" : Model.Issue.Build)</td>
                </tr>
                @if (Model.Issue.CustomValues.Any())
                {
                    <tr>
                        <th class="bg-light text-secondary">Custom Fields</th>
                        <td colspan="3">
                            <div class="row g-2">
                                @foreach (var cv in Model.Issue.CustomValues)
                                {
                                    <div class="col-md-4">
                                        <span class="text-muted small">@cv.CustomField?.Name:</span>
                                        <strong class="text-dark">@cv.Value</strong>
                                    </div>
                                }
                            </div>
                        </td>
                    </tr>
                }
                <tr>
                    <th class="bg-light text-secondary">Summary</th>
                    <td colspan="3" class="fw-bold">@Model.Issue.Summary</td>
                </tr>
                <tr>
                    <th class="bg-light text-secondary">Description</th>
                    <td colspan="3" class="text-break" style="white-space: pre-line;">@Model.Issue.Description</td>
                </tr>
                @if (!string.IsNullOrWhiteSpace(Model.Issue.StepsToReproduce))
                {
                    <tr>
                        <th class="bg-light text-secondary">Steps to Reproduce</th>
                        <td colspan="3" class="text-break" style="white-space: pre-line;">@Model.Issue.StepsToReproduce</td>
                    </tr>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Issue.AdditionalInformation))
                {
                    <tr>
                        <th class="bg-light text-secondary">Additional Info</th>
                        <td colspan="3" class="text-break" style="white-space: pre-line;">@Model.Issue.AdditionalInformation</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Relationships Section (bug_relationship_inc.php) -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-light py-2 px-3 fw-bold small text-secondary d-flex justify-content-between align-items-center">
        <span><i class="bi bi-link-45deg me-1"></i> Issue Relationships</span>
        <span class="badge bg-secondary">@(Model.Issue.SourceRelationships.Count + Model.Issue.DestinationRelationships.Count) links</span>
    </div>
    <div class="card-body p-3">
        @if (!Model.Issue.SourceRelationships.Any() && !Model.Issue.DestinationRelationships.Any())
        {
            <p class="text-muted small mb-0">No relationships defined for this issue.</p>
        }
        else
        {
            <div class="table-responsive mb-3">
                <table class="table table-sm table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 140px;">Relationship</th>
                            <th style="width: 90px;">ID</th>
                            <th>Summary</th>
                            <th style="width: 100px;">Status</th>
                            <th style="width: 60px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rel in Model.Issue.SourceRelationships)
                        {
                            <tr>
                                <td><span class="badge bg-light text-dark border">@rel.Type</span></td>
                                <td class="font-monospace fw-bold">
                                    <a asp-action="Details" asp-route-id="@rel.DestinationIssueId">
                                        #@rel.DestinationIssueId.ToString("D7")
                                    </a>
                                </td>
                                <td>@(rel.DestinationIssue?.Summary ?? "Issue")</td>
                                <td><span class="badge bg-primary">@(rel.DestinationIssue?.Status.ToString() ?? "Open")</span></td>
                                <td>
                                    <form asp-action="DeleteRelationship" asp-route-id="@Model.Issue.Id" asp-route-relationshipId="@rel.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-1" title="Delete relationship">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @foreach (var rel in Model.Issue.DestinationRelationships)
                        {
                            <tr>
                                <td><span class="badge bg-light text-dark border">Inverse of @rel.Type</span></td>
                                <td class="font-monospace fw-bold">
                                    <a asp-action="Details" asp-route-id="@rel.SourceIssueId">
                                        #@rel.SourceIssueId.ToString("D7")
                                    </a>
                                </td>
                                <td>@(rel.SourceIssue?.Summary ?? "Issue")</td>
                                <td><span class="badge bg-primary">@(rel.SourceIssue?.Status.ToString() ?? "Open")</span></td>
                                <td>
                                    <form asp-action="DeleteRelationship" asp-route-id="@Model.Issue.Id" asp-route-relationshipId="@rel.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-1" title="Delete relationship">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- Add Relationship Form -->
        @if (Model.CanUpdate)
        {
            <form asp-action="AddRelationship" asp-route-id="@Model.Issue.Id" method="post" class="row g-2 align-items-center mt-2 border-top pt-2">
                @Html.AntiForgeryToken()
                <div class="col-auto">
                    <span class="small fw-semibold text-secondary">Add relationship:</span>
                </div>
                <div class="col-auto">
                    <select name="relType" class="form-select form-select-sm">
                        @foreach (RelationshipType rt in Enum.GetValues(typeof(RelationshipType)))
                        {
                            <option value="@rt">@rt</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <input type="number" name="destIssueId" class="form-control form-control-sm" placeholder="Target Issue ID (e.g. 1)" required />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-sm btn-outline-primary">Add Relation</button>
                </div>
            </form>
        }
    </div>
</div>

<!-- File Attachments Section (bug_file_inc.php) -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-light py-2 px-3 fw-bold small text-secondary d-flex justify-content-between align-items-center">
        <span><i class="bi bi-paperclip me-1"></i> File Attachments</span>
        <span class="badge bg-secondary">@Model.Issue.Attachments.Count() files</span>
    </div>
    <div class="card-body p-3">
        @if (!Model.Issue.Attachments.Any())
        {
            <p class="text-muted small mb-0">No files attached to this issue.</p>
        }
        else
        {
            <div class="table-responsive mb-3">
                <table class="table table-sm table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>File Name</th>
                            <th style="width: 100px;">Size</th>
                            <th style="width: 140px;">Date Added</th>
                            <th>Attached By</th>
                            <th>Description</th>
                            <th style="width: 120px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var att in Model.Issue.Attachments)
                        {
                            <tr>
                                <td>
                                    <i class="bi bi-file-earmark me-1 text-primary"></i>
                                    <strong>@att.FileName</strong>
                                </td>
                                <td>@(att.FileSize / 1024) KB</td>
                                <td class="text-muted">@att.DateAdded.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@(att.User?.RealName ?? att.User?.UserName ?? "User")</td>
                                <td>@att.Description</td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="DownloadAttachment" asp-route-id="@att.Id" class="btn btn-sm btn-outline-primary py-0 px-2">
                                            <i class="bi bi-download"></i>
                                        </a>
                                        @if (Model.CanDelete || Model.UserAccessLevel >= AccessLevel.Developer)
                                        {
                                            <form asp-action="DeleteAttachment" asp-route-id="@Model.Issue.Id" asp-route-attachmentId="@att.Id" method="post" onsubmit="return confirm('Delete this attachment?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- Upload Attachment Form (bug_file_add.php) -->
        @if (Model.CanAttachFile)
        {
            <form asp-action="UploadAttachment" asp-route-id="@Model.Issue.Id" method="post" enctype="multipart/form-data" class="row g-2 align-items-center mt-2 border-top pt-2">
                @Html.AntiForgeryToken()
                <div class="col-auto">
                    <span class="small fw-semibold text-secondary">Upload File:</span>
                </div>
                <div class="col-md-4 col-sm-6">
                    <input type="file" name="file" class="form-control form-control-sm" required />
                </div>
                <div class="col-md-4 col-sm-6">
                    <input type="text" name="description" class="form-control form-control-sm" placeholder="Optional description" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Upload</button>
                </div>
            </form>
        }
    </div>
</div>

<!-- Issue Monitors Section (bug_monitor_inc.php) -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-light py-2 px-3 fw-bold small text-secondary d-flex justify-content-between align-items-center">
        <span><i class="bi bi-eye me-1"></i> Issue Monitors</span>
        <span class="badge bg-secondary">@Model.Issue.Monitors.Count() users monitoring</span>
    </div>
    <div class="card-body p-3">
        <div class="d-flex flex-wrap gap-2 mb-3">
            @if (!Model.Issue.Monitors.Any())
            {
                <span class="text-muted small">No users are currently monitoring this issue.</span>
            }
            @foreach (var mon in Model.Issue.Monitors)
            {
                <span class="badge bg-light text-dark border p-2 d-flex align-items-center gap-2">
                    <i class="bi bi-person text-secondary"></i>
                    <span>@(mon.User?.RealName ?? mon.User?.UserName ?? "User")</span>
                    @if (Model.UserAccessLevel >= AccessLevel.Developer)
                    {
                        <form asp-action="RemoveMonitorUser" asp-route-id="@Model.Issue.Id" asp-route-monitorUserId="@mon.UserId" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-close btn-close-sm" style="font-size: 8px;" title="Remove monitor"></button>
                        </form>
                    }
                </span>
            }
        </div>

        @if (Model.UserAccessLevel >= AccessLevel.Developer)
        {
            <form asp-action="AddMonitorUser" asp-route-id="@Model.Issue.Id" method="post" class="row g-2 align-items-center border-top pt-2">
                @Html.AntiForgeryToken()
                <div class="col-auto">
                    <span class="small fw-semibold text-secondary">Add monitor:</span>
                </div>
                <div class="col-auto">
                    <select name="monitorUserId" class="form-select form-select-sm">
                        @foreach (var u in Model.AssignableUsers)
                        {
                            <option value="@u.Id">@(u.RealName ?? u.UserName)</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-sm btn-outline-primary">Add</button>
                </div>
            </form>
        }
    </div>
</div>

<!-- Status Transition & Workflow Action Bar -->
@if (Model.CanChangeStatus)
{
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-header bg-white border-bottom py-2 px-3 fw-bold small text-secondary">
            <i class="bi bi-arrow-repeat me-1"></i> Change Status / Workflow Transition
        </div>
        <div class="card-body p-3">
            <form asp-action="ChangeStatus" asp-route-id="@Model.Issue.Id" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">New Status</label>
                    <select name="status" class="form-select form-select-sm">
                        @foreach (IssueStatus s in Enum.GetValues(typeof(IssueStatus)))
                        {
                            <option value="@s" selected="@(Model.Issue.Status == s)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Resolution (if closing/resolving)</label>
                    <select name="resolution" class="form-select form-select-sm">
                        @foreach (ResolutionType r in Enum.GetValues(typeof(ResolutionType)))
                        {
                            <option value="@r" selected="@(Model.Issue.Resolution == r)">@r</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small text-muted mb-1">Optional Status Note</label>
                    <input type="text" name="note" class="form-control form-control-sm" placeholder="Brief explanation of status change" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-sm btn-success w-100 fw-semibold">Update Status</button>
                </div>
            </form>
        </div>
    </div>
}

<!-- Bug Notes Section (bugnote_inc.php) -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-light py-2 px-3 fw-bold small text-secondary d-flex justify-content-between align-items-center">
        <span><i class="bi bi-chat-left-text me-1"></i> Bug Notes & Discussion</span>
        <span class="badge bg-secondary">@Model.Issue.Notes.Count() notes</span>
    </div>
    <div class="card-body p-0">
        <ul class="list-group list-group-flush">
            @if (!Model.Issue.Notes.Any())
            {
                <li class="list-group-item text-center text-muted py-4 small">No bug notes posted on this issue yet.</li>
            }
            @foreach (var note in Model.Issue.Notes)
            {
                <li class="list-group-item p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2 small">
                        <div>
                            <strong class="text-dark">@(note.Reporter?.RealName ?? note.Reporter?.UserName ?? "User")</strong>
                            @if (note.IsFromSlack || !string.IsNullOrEmpty(note.SlackUserName))
                            {
                                <span class="badge bg-emerald-600 text-white ms-1 shadow-sm"><i class="bi bi-slack me-1"></i> @(note.SlackUserName ?? "Slack Thread")</span>
                            }
                            <span class="text-muted ms-1">(@note.DateSubmitted.ToString("yyyy-MM-dd HH:mm"))</span>
                            @if (note.ViewState == ProjectViewState.Private)
                            {
                                <span class="badge bg-danger ms-1"><i class="bi bi-lock-fill me-1"></i> Private</span>
                            }
                            @if (note.TimeTrackingMinutes > 0)
                            {
                                <span class="badge bg-info text-dark ms-1">
                                    <i class="bi bi-stopwatch me-1"></i>@note.TimeTrackingMinutes min
                                </span>
                            }
                        </div>
                        @if (Model.UserAccessLevel >= AccessLevel.Developer)
                        {
                            <form asp-action="DeleteNote" asp-route-id="@Model.Issue.Id" asp-route-noteId="@note.Id" method="post" onsubmit="return confirm('Delete this bug note?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        }
                    </div>
                    <p class="mb-0 text-break small" style="white-space: pre-line;">@note.Note</p>
                </li>
            }
        </ul>

        <!-- Add Bug Note Form (bugnote_add.php) -->
        @if (Model.CanAddNote)
        {
            <div class="card-footer bg-light p-3">
                <form asp-action="AddNote" asp-route-id="@Model.Issue.Id" method="post">
                    @Html.AntiForgeryToken()
                    <label class="form-label small fw-semibold text-secondary">Add Bug Note</label>
                    <textarea name="noteText" class="form-control form-control-sm mb-2" rows="3" placeholder="Enter comments, resolution notes, or technical observations..." required></textarea>

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="d-flex align-items-center gap-3">
                            <div class="form-check small">
                                <input type="checkbox" name="isPrivate" value="true" class="form-check-input" id="chkNotePrivate" />
                                <label class="form-check-label text-danger fw-semibold" for="chkNotePrivate">
                                    <i class="bi bi-lock-fill me-1"></i> Private
                                </label>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <span class="small text-muted">Time spent (min):</span>
                                <input type="number" name="timeTracking" class="form-control form-control-sm" style="width: 80px;" value="0" min="0" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm px-4 fw-semibold">
                            <i class="bi bi-plus-circle me-1"></i> Add Note
                        </button>
                    </div>
                </form>
            </div>
        }
    </div>
</div>

<!-- Audit History Timeline (history_inc.php) -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-light py-2 px-3 fw-bold small text-secondary d-flex justify-content-between align-items-center">
        <span><i class="bi bi-clock-history me-1"></i> Issue History Audit Log</span>
        <span class="badge bg-secondary">@Model.Issue.History.Count() events</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th style="width: 140px;">Date Modified</th>
                        <th style="width: 140px;">Username</th>
                        <th style="width: 150px;">Field</th>
                        <th>Change</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Issue.History.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-3">No history events recorded.</td>
                        </tr>
                    }
                    @foreach (var h in Model.Issue.History)
                    {
                        <tr>
                            <td class="text-muted">@h.DateModified.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><strong>@(h.User?.RealName ?? h.User?.UserName ?? "System")</strong></td>
                            <td><span class="badge bg-light text-dark border">@h.FieldName</span></td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(h.OldValue))
                                {
                                    <span class="text-decoration-line-through text-muted me-1">@h.OldValue</span>
                                    <i class="bi bi-arrow-right text-muted small me-1"></i>
                                }
                                <span class="fw-semibold">@h.NewValue</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
