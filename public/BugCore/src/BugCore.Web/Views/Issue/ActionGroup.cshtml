@model BugCore.Web.ViewModels.Issues.BugActionGroupViewModel
@{
    ViewData["Title"] = "Action Group Confirmation";
    var actionTitle = Model.Action?.ToLower() switch
    {
        "status" => "Change Issue Status",
        "assign" => "Reassign Issues",
        "priority" => "Change Issue Priority",
        "severity" => "Change Issue Severity",
        "viewstate" => "Change View Status (Public/Private)",
        "move" => "Move Issues to Another Project",
        "delete" => "Permanently Delete Selected Issues",
        _ => "Batch Operation"
    };
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-stack me-2 text-primary"></i> @actionTitle</h5>
                <span class="badge bg-secondary">@Model.IssueIds.Count issues selected</span>
            </div>
            <div class="card-body p-4">
                <form asp-action="ExecuteActionGroup" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Action" />

                    @for (int i = 0; i < Model.IssueIds.Count; i++)
                    {
                        <input type="hidden" name="IssueIds[@i]" value="@Model.IssueIds[i]" />
                    }

                    <!-- Selected Issues Summary List -->
                    <div class="mb-4">
                        <label class="form-label fw-bold small text-secondary">Target Issues</label>
                        <div class="table-responsive border rounded bg-light" style="max-height: 220px; overflow-y: auto;">
                            <table class="table table-sm table-hover mb-0 small">
                                <thead class="table-white text-secondary sticky-top bg-white">
                                    <tr>
                                        <th style="width: 90px;">ID</th>
                                        <th>Project</th>
                                        <th>Summary</th>
                                        <th style="width: 110px;">Status</th>
                                        <th style="width: 120px;">Handler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var issue in Model.Issues)
                                    {
                                        <tr>
                                            <td class="font-monospace fw-bold">#@issue.Id.ToString("D7")</td>
                                            <td>@(issue.Project?.Name ?? "Project")</td>
                                            <td class="text-truncate" style="max-width: 300px;">@issue.Summary</td>
                                            <td><span class="badge bg-light text-dark border">@issue.Status</span></td>
                                            <td>@(issue.Handler?.RealName ?? issue.Handler?.UserName ?? "Unassigned")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Action Specific Fields -->
                    @if (Model.Action?.ToLower() == "status")
                    {
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="NewStatus" class="form-label small fw-semibold">New Status</label>
                                <select asp-for="NewStatus" asp-items="Html.GetEnumSelectList<IssueStatus>()" class="form-select"></select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NewResolution" class="form-label small fw-semibold">Resolution (Optional)</label>
                                <select asp-for="NewResolution" class="form-select">
                                    <option value="">[ Leave unchanged / default ]</option>
                                    @foreach (ResolutionType res in Enum.GetValues(typeof(ResolutionType)))
                                    {
                                        <option value="@res">@res</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ActionNote" class="form-label small fw-semibold">Optional Bug Note for all selected issues</label>
                            <textarea asp-for="ActionNote" class="form-control" rows="3" placeholder="Add explanation for batch status update..."></textarea>
                        </div>
                    }
                    else if (Model.Action?.ToLower() == "assign")
                    {
                        <div class="mb-4">
                            <label asp-for="NewHandlerId" class="form-label small fw-semibold">Assign All Selected Issues To</label>
                            <select asp-for="NewHandlerId" class="form-select">
                                <option value="">[ None / Unassigned ]</option>
                                @foreach (var u in Model.Users)
                                {
                                    <option value="@u.Id">@(u.RealName ?? u.UserName) (@u.Email)</option>
                                }
                            </select>
                        </div>
                    }
                    else if (Model.Action?.ToLower() == "priority")
                    {
                        <div class="mb-4">
                            <label asp-for="NewPriority" class="form-label small fw-semibold">Set Priority To</label>
                            <select asp-for="NewPriority" asp-items="Html.GetEnumSelectList<IssuePriority>()" class="form-select"></select>
                        </div>
                    }
                    else if (Model.Action?.ToLower() == "severity")
                    {
                        <div class="mb-4">
                            <label asp-for="NewSeverity" class="form-label small fw-semibold">Set Severity To</label>
                            <select asp-for="NewSeverity" asp-items="Html.GetEnumSelectList<IssueSeverity>()" class="form-select"></select>
                        </div>
                    }
                    else if (Model.Action?.ToLower() == "viewstate")
                    {
                        <div class="mb-4">
                            <label asp-for="NewViewState" class="form-label small fw-semibold">Set View Status To</label>
                            <select asp-for="NewViewState" class="form-select">
                                <option value="@ProjectViewState.Public">Public</option>
                                <option value="@ProjectViewState.Private">Private</option>
                            </select>
                        </div>
                    }
                    else if (Model.Action?.ToLower() == "move")
                    {
                        <div class="mb-4">
                            <label asp-for="NewProjectId" class="form-label small fw-semibold">Destination Project</label>
                            <select asp-for="NewProjectId" class="form-select">
                                @foreach (var p in Model.Projects)
                                {
                                    <option value="@p.Id">@p.Name</option>
                                }
                            </select>
                        </div>
                    }
                    else if (Model.Action?.ToLower() == "delete")
                    {
                        <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                            <div>
                                <strong>Warning: Permanent Deletion!</strong><br />
                                Are you sure you want to permanently delete these @Model.IssueIds.Count issue(s) along with their bug notes, attachments, and audit history?
                            </div>
                        </div>
                    }
                    else if (Model.Action?.ToLower() == "tags" || Model.Action?.ToLower() == "attach_tags")
                    {
                        <div class="mb-4">
                            <label asp-for="TagNames" class="form-label small fw-semibold">Tags to Attach (comma separated)</label>
                            <input asp-for="TagNames" class="form-control" placeholder="e.g. backend, urgent, ui-fix" />
                            <div class="form-text small text-muted">Enter one or more tag names separated by commas. Existing tags will be linked or created if new.</div>
                        </div>
                    }

                    <div class="d-flex justify-content-between border-top pt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn @(Model.Action?.ToLower() == "delete" ? "btn-danger" : "btn-primary") px-4 fw-semibold">
                            Confirm Batch Action
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
