@model BugCore.Core.Entities.CustomField
@using BugCore.Core.Enums

@{
    ViewData["Title"] = "New Custom Field - BugCoreBT";
}

<div class="container py-4 max-w-2xl">
    <div class="mb-4">
        <a asp-action="Index" class="text-emerald-400 text-decoration-none small">
            <i class="bi bi-arrow-left me-1"></i> Back to Custom Fields
        </a>
        <h2 class="fw-bold mt-2"><i class="bi bi-ui-checks me-2"></i>Create Custom Field</h2>
    </div>

    <div class="card bg-slate-900 border-slate-800 shadow">
        <div class="card-body p-4">
            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold text-slate-300">Field Name *</label>
                    <input asp-for="Name" class="form-control bg-slate-800 border-slate-700 text-slate-100" placeholder="e.g. Operating System" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Type" class="form-label fw-semibold text-slate-300">Field Type *</label>
                    <select asp-for="Type" class="form-select bg-slate-800 border-slate-700 text-slate-100" asp-items="Html.GetEnumSelectList<CustomFieldType>()"></select>
                </div>

                <div class="mb-3">
                    <label asp-for="PossibleValues" class="form-label fw-semibold text-slate-300">Possible Values (pipe '|' separated for lists)</label>
                    <input asp-for="PossibleValues" class="form-control bg-slate-800 border-slate-700 text-slate-100" placeholder="e.g. Windows|Linux|macOS|Android|iOS" />
                </div>

                <div class="mb-3">
                    <label asp-for="DefaultValue" class="form-label fw-semibold text-slate-300">Default Value</label>
                    <input asp-for="DefaultValue" class="form-control bg-slate-800 border-slate-700 text-slate-100" />
                </div>

                <div class="mb-3">
                    <label asp-for="RegularExpression" class="form-label fw-semibold text-slate-300">Validation RegEx Pattern</label>
                    <input asp-for="RegularExpression" class="form-control bg-slate-800 border-slate-700 text-slate-100" placeholder="e.g. ^[0-9]+$" />
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <label asp-for="ReadAccessLevel" class="form-label fw-semibold text-slate-300">Read Access Level</label>
                        <select asp-for="ReadAccessLevel" class="form-select bg-slate-800 border-slate-700 text-slate-100" asp-items="Html.GetEnumSelectList<AccessLevel>()"></select>
                    </div>
                    <div class="col-6">
                        <label asp-for="WriteAccessLevel" class="form-label fw-semibold text-slate-300">Write Access Level</label>
                        <select asp-for="WriteAccessLevel" class="form-select bg-slate-800 border-slate-700 text-slate-100" asp-items="Html.GetEnumSelectList<AccessLevel>()"></select>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-6">
                        <div class="form-check">
                            <input asp-for="DisplayOnReport" class="form-check-input" type="checkbox" id="displayReport">
                            <label class="form-check-label text-slate-300" for="displayReport">Display on Report Issue</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="DisplayOnUpdate" class="form-check-input" type="checkbox" id="displayUpdate">
                            <label class="form-check-label text-slate-300" for="displayUpdate">Display on Update Issue</label>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-check">
                            <input asp-for="RequireOnReport" class="form-check-input" type="checkbox" id="reqReport">
                            <label class="form-check-label text-slate-300" for="reqReport">Required on Report</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="RequireOnUpdate" class="form-check-input" type="checkbox" id="reqUpdate">
                            <label class="form-check-label text-slate-300" for="reqUpdate">Required on Update</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-slate-800 text-slate-300">Cancel</a>
                    <button type="submit" class="btn btn-emerald text-white fw-semibold px-4">Create Field</button>
                </div>
            </form>
        </div>
    </div>
</div>
