@model IEnumerable<BugCore.Core.Entities.CustomField>
@using BugCore.Core.Enums

@{
    ViewData["Title"] = "Custom Fields - BugCoreBT";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-ui-checks me-2"></i>Custom Fields</h2>
            <p class="text-muted small mb-0">BugCoreBT Custom Attributes & Field Definitions</p>
        </div>
        <a asp-action="Create" class="btn btn-emerald text-white px-3 fw-semibold">
            <i class="bi bi-plus-lg me-1"></i> New Custom Field
        </a>
    </div>

    <div class="card bg-slate-900 border-slate-800 shadow">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr class="border-bottom border-slate-800 text-slate-400 text-uppercase fs-7">
                        <th>Field Name</th>
                        <th>Type</th>
                        <th>Possible Values</th>
                        <th>Default Value</th>
                        <th>Read Access</th>
                        <th>Write Access</th>
                        <th>Linked Projects</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-slate-500">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                No custom fields defined yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var field in Model)
                        {
                            <tr>
                                <td class="fw-bold text-white">@field.Name</td>
                                <td>
                                    <span class="badge bg-slate-800 text-emerald-400 border border-slate-700">
                                        @field.Type
                                    </span>
                                </td>
                                <td class="text-slate-300 small">@(string.IsNullOrEmpty(field.PossibleValues) ? "-" : field.PossibleValues)</td>
                                <td class="text-slate-300 small">@(string.IsNullOrEmpty(field.DefaultValue) ? "-" : field.DefaultValue)</td>
                                <td><span class="badge bg-slate-800 text-slate-300 border border-slate-700">@field.ReadAccessLevel</span></td>
                                <td><span class="badge bg-slate-800 text-slate-300 border border-slate-700">@field.WriteAccessLevel</span></td>
                                <td><span class="badge bg-slate-800 text-emerald-400">@field.ProjectLinks.Count</span></td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@field.Id" class="btn btn-outline-slate-700 text-slate-300">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <form method="post" asp-action="Delete" asp-route-id="@field.Id" class="d-inline" onsubmit="return confirm('Delete custom field @field.Name?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-slate-700 text-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
