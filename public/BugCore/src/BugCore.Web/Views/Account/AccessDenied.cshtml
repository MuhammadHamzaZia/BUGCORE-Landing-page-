@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-danger border-opacity-25 text-center p-4">
                <div class="mb-3">
                    <span class="display-1 text-danger"><i class="bi bi-shield-x"></i></span>
                </div>
                <h3 class="fw-bold text-danger mb-2">Access Denied</h3>
                <p class="text-muted mb-4">
                    Your account does not possess the required threshold access level for this operation, or this project is private.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Return to My View
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Switch User
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
