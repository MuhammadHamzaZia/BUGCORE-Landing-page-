@model int?
@{
    ViewData["Title"] = "Project Documentation";
}

<div class="row">
    <div class="col-md-12">
        <div class="widget-box widget-color-blue2">
            <div class="widget-header widget-header-small">
                <h4 class="widget-title lighter">
                    <i class="ace-icon fa fa-file-text-o"></i>
                    Project Documents
                </h4>
            </div>
            <div class="widget-body">
                <div class="widget-main no-padding">
                    <form asp-controller="ProjectDoc" asp-action="Update" method="post" enctype="multipart/form-data" class="padding-12">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="fileId" value="1" />
                        
                        <div class="form-group">
                            <label>Document Title</label>
                            <input type="text" name="title" class="form-control" placeholder="Title" required />
                        </div>
                        <div class="form-group">
                            <label>Description</label>
                            <textarea name="description" class="form-control" rows="3" placeholder="Description"></textarea>
                        </div>
                        <div class="form-group">
                            <label>File Upload</label>
                            <input type="file" name="file" class="form-control-file" />
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fa fa-save"></i> Save Document
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
