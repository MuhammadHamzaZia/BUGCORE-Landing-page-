@{
    ViewData["Title"] = "Microsoft Teams Adaptive Cards Connector";
    var sampleIssue = ViewBag.SampleIssue as BugCore.Core.Entities.Issue;
    var sampleCardJson = ViewBag.SampleCardJson as string ?? "{}";
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom border-slate-300">
        <div>
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-microsoft-teams text-indigo-600 fs-2"></i>
                <div>
                    <h3 class="fw-bold mb-0 text-slate-900">Microsoft Teams Connector</h3>
                    <span class="text-slate-600 small fw-medium">Incoming Webhooks, Adaptive Cards v1.4, deep-link routing, and rate-limit throttling</span>
                </div>
            </div>
        </div>
        <div>
            <span class="badge bg-indigo-950 text-indigo-300 border border-indigo-800 px-3 py-2">
                <i class="bi bi-card-heading me-1"></i> Adaptive Cards v1.4 Enabled
            </span>
        </div>
    </div>

    <div class="row g-4">
        <!-- LEFT: Webhook Setup & Simulator -->
        <div class="col-lg-7">
            <!-- WEBHOOK DISPATCH CARD -->
            <div class="card bg-slate-900 border-slate-800 shadow mb-4">
                <div class="card-header bg-slate-850 border-slate-800 py-3">
                    <h6 class="fw-bold text-white mb-0">
                        <i class="bi bi-send-check text-indigo-400 me-2"></i> Dispatch Adaptive Card to Teams Channel
                    </h6>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Teams" asp-action="SendTestCard" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label text-slate-300 small fw-bold">Teams Incoming Webhook URL</label>
                            <input type="url" name="webhookUrl" class="form-control bg-slate-950 border-slate-800 text-white font-monospace small" placeholder="https://outlook.office.com/webhook/..." value="https://outlook.office.com/webhook/TEST-TEAMS-CONNECTOR-ENDPOINT" required />
                            <div class="form-text text-slate-500 small">
                                Paste the Incoming Webhook connector URL created in your target MS Teams channel.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-slate-300 small fw-bold">Target Defect Issue</label>
                            <input type="number" name="issueId" class="form-control bg-slate-950 border-slate-800 text-white" value="@(sampleIssue?.Id ?? 1)" required />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-indigo text-white fw-bold shadow-sm">
                                <i class="bi bi-rocket-takeoff me-1"></i> Post Adaptive Card to Teams
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- THROTTLING & BATCHING SIMULATOR -->
            <div class="card bg-slate-900 border-slate-800 shadow mb-4">
                <div class="card-header bg-slate-850 border-slate-800 py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-white mb-0">
                        <i class="bi bi-speedometer2 text-amber-400 me-2"></i> Rate-Limit Throttling & Batch Updates
                    </h6>
                    <span class="badge bg-amber-950 text-amber-400 border border-amber-800">4 Events Aggregated</span>
                </div>
                <div class="card-body p-4">
                    <p class="text-slate-400 small mb-3">
                        When multiple updates occur on a defect within seconds (e.g. 4 tags added in rapid succession), pushing individual cards triggers MS Teams rate limits. BUGCORE aggregates quick updates into a single throttled Adaptive Card update.
                    </p>
                    <form asp-controller="Teams" asp-action="SimulateThrottledBatch" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="issueId" value="@(sampleIssue?.Id ?? 1)" />
                        <input type="hidden" name="webhookUrl" value="https://outlook.office.com/webhook/TEST-TEAMS-CONNECTOR-ENDPOINT" />
                        <button type="submit" class="btn btn-outline-amber text-amber-400 fw-bold">
                            <i class="bi bi-cpu me-1"></i> Simulate Throttled Batch Update
                        </button>
                    </form>
                </div>
            </div>

            <!-- ARCHITECTURE COMPARISON GUARDRAILS -->
            <div class="card bg-slate-900 border-slate-800 shadow">
                <div class="card-header bg-slate-850 border-slate-800 py-3">
                    <h6 class="fw-bold text-white mb-0">
                        <i class="bi bi-shield-exclamation text-cyan-400 me-2"></i> Security Guardrails & Interactivity
                    </h6>
                </div>
                <div class="card-body p-4 small text-slate-300">
                    <div class="mb-3">
                        <h6 class="fw-bold text-cyan-300"><i class="bi bi-info-circle me-1"></i> Incoming Webhooks vs Bot Framework</h6>
                        <p class="text-slate-400 mb-2">
                            Basic Incoming Webhooks support rendering Adaptive Cards and <code>Action.OpenUrl</code> deep-link buttons. However, Microsoft Teams strictly rejects <code>Action.Submit</code> interactive payloads on webhook channels.
                        </p>
                        <div class="bg-slate-950 p-3 rounded border border-slate-800 font-monospace text-slate-400">
                            • Basic Webhook: 1-Way Read-Only Cards + Deep Links (Action.OpenUrl)<br />
                            • Azure Bot Framework: 2-Way ChatOps with Submit Actions (Action.Submit)
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: Live Adaptive Card JSON & Preview -->
        <div class="col-lg-5">
            <div class="card bg-slate-900 border-slate-800 shadow h-100">
                <div class="card-header bg-slate-850 border-slate-800 py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-white mb-0">
                        <i class="bi bi-code-slash text-indigo-400 me-2"></i> Generated Adaptive Card Payload
                    </h6>
                    <button type="button" class="btn btn-sm btn-slate-800 text-slate-300" onclick="navigator.clipboard.writeText(document.getElementById('cardJsonText').innerText);">
                        <i class="bi bi-clipboard me-1"></i> Copy JSON
                    </button>
                </div>
                <div class="card-body p-3">
                    <pre class="bg-slate-950 text-indigo-300 p-3 rounded border border-slate-800 font-monospace small mb-0" style="max-height: 550px; overflow-y: auto;" id="cardJsonText">@sampleCardJson</pre>
                </div>
            </div>
        </div>
    </div>
</div>
