@{
    ViewData["Title"] = "Git Repository Commit Linker";
    var issues = ViewBag.Issues as IEnumerable<BugCore.Core.Entities.Issue> ?? new List<BugCore.Core.Entities.Issue>();
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom border-slate-300">
        <div>
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-github text-slate-900 fs-2"></i>
                <div>
                    <h3 class="fw-bold mb-0 text-slate-900">Git Repository Commit Linker</h3>
                    <span class="text-slate-600 small fw-medium">Webhooks for GitHub, GitLab & Bitbucket with HMAC verification, syntax parsing, and branch-to-version mapping</span>
                </div>
            </div>
        </div>
        <div>
            <span class="badge bg-slate-800 text-slate-300 border border-slate-700 px-3 py-2 font-monospace">
                POST /api/git/webhook
            </span>
        </div>
    </div>

    <div class="row g-4">
        <!-- LEFT: Commit Push Simulator & Webhook Setup -->
        <div class="col-lg-7">
            <!-- COMMIT SIMULATOR CARD -->
            <div class="card bg-slate-900 border-slate-800 shadow mb-4">
                <div class="card-header bg-slate-850 border-slate-800 py-3">
                    <h6 class="fw-bold text-white mb-0">
                        <i class="bi bi-git text-emerald-400 me-2"></i> Simulate Incoming Git Push Webhook
                    </h6>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="GitWebhook" asp-action="SimulateCommitPush" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label text-slate-300 small fw-bold">Select Defect Issue to Target</label>
                            <select name="issueId" class="form-select bg-slate-950 border-slate-800 text-white" required>
                                @foreach (var issue in issues)
                                {
                                    <option value="@issue.Id">#@issue.Id - @issue.Summary (@issue.Status)</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-slate-300 small fw-bold">Commit Message Summary</label>
                            <input type="text" name="commitMsg" class="form-control bg-slate-950 border-slate-800 text-white" value="Refactored null check in authentication middleware" required />
                            <div class="form-text text-slate-500 small">
                                The system will append issue transition syntax like <code class="text-emerald-400">Fixes #101</code> automatically.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-slate-300 small fw-bold">Git Repository Branch</label>
                            <select name="branch" class="form-select bg-slate-950 border-slate-800 text-white">
                                <option value="main" selected>main (Triggers Branch-to-Version Release Mapping)</option>
                                <option value="feature/login-fix">feature/login-fix (Links commit note without version increment)</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-emerald text-white fw-bold shadow-sm">
                            <i class="bi bi-play-circle me-1"></i> Trigger Git Webhook Event
                        </button>
                    </form>
                </div>
            </div>

            <!-- SYNTAX GUIDE CARD -->
            <div class="card bg-slate-900 border-slate-800 shadow">
                <div class="card-header bg-slate-850 border-slate-800 py-3">
                    <h6 class="fw-bold text-white mb-0">
                        <i class="bi bi-journal-code text-cyan-400 me-2"></i> Supported Commit Message Syntax
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="table-responsive">
                        <table class="table table-dark table-sm border-slate-800 align-middle mb-0">
                            <thead>
                                <tr class="text-slate-400 small">
                                    <th>Syntax Action</th>
                                    <th>Example Message</th>
                                    <th>Resulting Workflow</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                <tr>
                                    <td><span class="badge bg-emerald-950 text-emerald-400 border border-emerald-800">Resolve</span></td>
                                    <td><code class="text-white">Fixes #104</code>, <code class="text-white">Closes #104</code></td>
                                    <td>Marks defect as <strong>Resolved (Fixed)</strong> & adds commit note.</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-cyan-950 text-cyan-400 border border-cyan-800">Reference</span></td>
                                    <td><code class="text-white">Refs #104</code>, <code class="text-white">See #104</code></td>
                                    <td>Appends commit changeset note to defect without changing status.</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-purple-950 text-purple-400 border border-purple-800">Version</span></td>
                                    <td>Pushed to <code class="text-white">main</code> / <code class="text-white">master</code></td>
                                    <td>Maps bug to current unreleased project version (<code class="text-emerald-400">Fixed In Version</code>).</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: Security Guardrails & Endpoint Details -->
        <div class="col-lg-5">
            <div class="card bg-slate-900 border-slate-800 shadow h-100">
                <div class="card-header bg-slate-850 border-slate-800 py-3">
                    <h6 class="fw-bold text-white mb-0">
                        <i class="bi bi-shield-lock text-cyan-400 me-2"></i> HMAC Security & Identity Verification
                    </h6>
                </div>
                <div class="card-body p-4 text-slate-300 small">
                    <div class="mb-4">
                        <h6 class="fw-bold text-white mb-1"><i class="bi bi-key-fill text-cyan-400 me-1"></i> HMAC SHA-256 Validation</h6>
                        <p class="text-slate-400">
                            The webhook endpoint validates incoming signatures (<code class="text-cyan-300">X-Hub-Signature-256</code> for GitHub, <code class="text-cyan-300">X-Gitlab-Token</code> for GitLab) using constant-time cryptographic comparisons (`FixedTimeEquals`) to prevent spoofed commit submissions.
                        </p>
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold text-white mb-1"><i class="bi bi-person-badge text-emerald-400 me-1"></i> Author Identity Mapping</h6>
                        <p class="text-slate-400">
                            Because developers can easily spoof author emails in local git configs (`git config user.email`), BUGCORE resolves commit authors against verified internal database accounts before recording status modifications.
                        </p>
                    </div>

                    <div class="p-3 bg-slate-950 border border-slate-800 rounded">
                        <div class="text-slate-400 fw-bold mb-1">Webhook Configuration URL:</div>
                        <div class="font-monospace text-emerald-400 select-all">https://your-domain.com/api/git/webhook</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
