@using BugCore.Core.Entities
@using BugCore.Core.Enums

@{
    ViewData["Title"] = "Admin Portal - BUGCORE Administration";
    var recentUsers = ViewBag.RecentUsers as List<ApplicationUser> ?? new List<ApplicationUser>();
    var recentProjects = ViewBag.RecentProjects as List<Project> ?? new List<Project>();
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-shield-lock me-2 text-warning"></i>Admin Portal</h2>
            <p class="text-muted small mb-0">BUGCORE System Administration, Management & Schema Diagnostics</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="ManageUser" asp-action="Index" class="btn btn-outline-slate-700 text-slate-200 btn-sm fw-semibold">
                <i class="bi bi-people me-1"></i> Manage Users
            </a>
            <a asp-controller="Project" asp-action="Index" class="btn btn-outline-slate-700 text-slate-200 btn-sm fw-semibold">
                <i class="bi bi-folder2 me-1"></i> Manage Projects
            </a>
            <a asp-controller="CustomField" asp-action="Index" class="btn btn-outline-slate-700 text-slate-200 btn-sm fw-semibold">
                <i class="bi bi-ui-checks me-1"></i> Custom Fields
            </a>
        </div>
    </div>

    <!-- Stat Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-slate-900 border-slate-800 shadow-sm p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-slate-400 small text-uppercase font-monospace fw-bold">User Accounts</div>
                        <div class="fs-3 fw-bold text-white mt-1">@ViewBag.TotalUsers</div>
                        <div class="text-emerald-400 small"><i class="bi bi-check-circle-fill me-1"></i>@ViewBag.ActiveUsers Active</div>
                    </div>
                    <div class="bg-slate-800 p-3 rounded text-emerald-400 fs-3">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-slate-900 border-slate-800 shadow-sm p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-slate-400 small text-uppercase font-monospace fw-bold">Projects Defined</div>
                        <div class="fs-3 fw-bold text-white mt-1">@ViewBag.TotalProjects</div>
                        <div class="text-slate-400 small"><i class="bi bi-diagram-3 me-1"></i>Hierarchy Supported</div>
                    </div>
                    <div class="bg-slate-800 p-3 rounded text-sky-400 fs-3">
                        <i class="bi bi-folder-symlink-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-slate-900 border-slate-800 shadow-sm p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-slate-400 small text-uppercase font-monospace fw-bold">Total Defect Logs</div>
                        <div class="fs-3 fw-bold text-white mt-1">@ViewBag.TotalIssues</div>
                        <div class="text-amber-400 small"><i class="bi bi-hourglass-split me-1"></i>@ViewBag.OpenIssues Open</div>
                    </div>
                    <div class="bg-slate-800 p-3 rounded text-amber-400 fs-3">
                        <i class="bi bi-bug-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-slate-900 border-slate-800 shadow-sm p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-slate-400 small text-uppercase font-monospace fw-bold">Custom Attributes</div>
                        <div class="fs-3 fw-bold text-white mt-1">@ViewBag.TotalCustomFields</div>
                        <div class="text-purple-400 small"><i class="bi bi-sliders me-1"></i>Global & Project-bound</div>
                    </div>
                    <div class="bg-slate-800 p-3 rounded text-purple-400 fs-3">
                        <i class="bi bi-ui-checks"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Administrative Portals -->
    <div class="row g-4 mb-4">
        <!-- System Administration Modules -->
        <div class="col-lg-8">
            <div class="card bg-slate-900 border-slate-800 shadow mb-4">
                <div class="card-header bg-slate-800 border-slate-700 py-3 fw-bold text-white d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-grid-3x3-gap-fill me-2 text-emerald-400"></i>Administrative Management Hub</span>
                    <span class="badge bg-emerald-500 text-slate-950 font-monospace">BugCoreBT Core</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <a asp-controller="ManageUser" asp-action="Index" class="card bg-slate-800 border-slate-700 text-decoration-none p-3 h-100 hover-border-emerald transition-all">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="bg-emerald-500 bg-opacity-10 text-emerald-400 p-3 rounded">
                                        <i class="bi bi-person-lines-fill fs-3"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold text-white mb-1">User Management</h5>
                                        <p class="text-slate-400 small mb-2">Create users, manage access levels (Viewer, Reporter, Developer, Manager, Administrator), reset credentials.</p>
                                        <div class="d-flex gap-2">
                                            <span class="btn btn-sm btn-emerald text-white fw-semibold"><i class="bi bi-person-plus-fill me-1"></i> Register New User</span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>

                        <div class="col-md-6">
                            <a asp-controller="Project" asp-action="Index" class="card bg-slate-800 border-slate-700 text-decoration-none p-3 h-100 hover-border-emerald transition-all">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="bg-sky-500 bg-opacity-10 text-sky-400 p-3 rounded">
                                        <i class="bi bi-diagram-3-fill fs-3"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold text-white mb-1">Project & Subprojects</h5>
                                        <p class="text-slate-400 small mb-0">Configure project hierarchies, set view states, assign project users, manage categories and versions.</p>
                                    </div>
                                </div>
                            </a>
                        </div>

                        <div class="col-md-6">
                            <a asp-controller="CustomField" asp-action="Index" class="card bg-slate-800 border-slate-700 text-decoration-none p-3 h-100 hover-border-emerald transition-all">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="bg-purple-500 bg-opacity-10 text-purple-400 p-3 rounded">
                                        <i class="bi bi-sliders2 fs-3"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold text-white mb-1">Custom Fields</h5>
                                        <p class="text-slate-400 small mb-0">Define custom defect attributes (String, Numeric, List, RegEx), read/write access permissions, and project bindings.</p>
                                    </div>
                                </div>
                            </a>
                        </div>

                        <div class="col-md-6">
                            <a asp-controller="Issue" asp-action="Index" class="card bg-slate-800 border-slate-700 text-decoration-none p-3 h-100 hover-border-emerald transition-all">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="bg-amber-500 bg-opacity-10 text-amber-400 p-3 rounded">
                                        <i class="bi bi-stack fs-3"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold text-white mb-1">Defect Triage & Batch Actions</h5>
                                        <p class="text-slate-400 small mb-0">Filter and perform bulk updates, reassignment, resolution, or deletion across issues using action groups.</p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent System Accounts -->
            <div class="card bg-slate-900 border-slate-800 shadow">
                <div class="card-header bg-slate-800 border-slate-700 py-3 fw-bold text-white d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-people me-2 text-emerald-400"></i>Recently Registered Accounts</span>
                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="ManageUser" asp-action="Create" class="btn btn-sm btn-emerald text-white fw-semibold">
                            <i class="bi bi-person-plus-fill me-1"></i> Register User
                        </a>
                        <a asp-controller="ManageUser" asp-action="Index" class="text-emerald-400 small text-decoration-none ms-2">View All Users &rarr;</a>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead>
                            <tr class="border-bottom border-slate-800 text-slate-400 text-uppercase fs-7">
                                <th>Username</th>
                                <th>Real Name</th>
                                <th>Global Access Level</th>
                                <th>Status</th>
                                <th class="text-end">Registered</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in recentUsers)
                            {
                                <tr>
                                    <td class="fw-bold text-white">@u.UserName</td>
                                    <td class="text-slate-300">@(string.IsNullOrEmpty(u.RealName) ? "-" : u.RealName)</td>
                                    <td>
                                        <span class="badge bg-slate-800 text-emerald-400 border border-slate-700">@u.GlobalAccessLevel</span>
                                    </td>
                                    <td>
                                        @if (u.Enabled)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Disabled</span>
                                        }
                                    </td>
                                    <td class="text-end text-slate-400 small">@u.DateCreated.ToString("yyyy-MM-dd")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- System & Database Information Sidebar -->
        <div class="col-lg-4">
            <div class="card bg-slate-900 border-slate-800 shadow mb-4">
                <div class="card-header bg-slate-800 border-slate-700 py-3 fw-bold text-white">
                    <i class="bi bi-cpu me-2 text-sky-400"></i>System & Environment
                </div>
                <div class="card-body p-3">
                    <ul class="list-group list-group-flush bg-transparent">
                        <li class="list-group-item bg-transparent text-slate-300 border-slate-800 d-flex justify-content-between px-0">
                            <span class="text-slate-400">Platform</span>
                            <span class="fw-semibold text-white">BugCoreBT .NET Core MVC</span>
                        </li>
                        <li class="list-group-item bg-transparent text-slate-300 border-slate-800 d-flex justify-content-between px-0">
                            <span class="text-slate-400">Runtime Target</span>
                            <span class="badge bg-slate-800 text-sky-400 border border-slate-700">.NET 8.0</span>
                        </li>
                        <li class="list-group-item bg-transparent text-slate-300 border-slate-800 d-flex justify-content-between px-0">
                            <span class="text-slate-400">ORM & Migration</span>
                            <span class="fw-semibold text-slate-200">Entity Framework Core</span>
                        </li>
                        <li class="list-group-item bg-transparent text-slate-300 border-slate-800 d-flex justify-content-between px-0">
                            <span class="text-slate-400">Database Engine</span>
                            <span class="badge bg-slate-800 text-emerald-400 border border-slate-700">BugCoreDbContext (SQLite/EF)</span>
                        </li>
                        <li class="list-group-item bg-transparent text-slate-300 border-slate-800 d-flex justify-content-between px-0">
                            <span class="text-slate-400">Authentication</span>
                            <span class="fw-semibold text-slate-200">ASP.NET Core Identity</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Database Entity Summary -->
            <div class="card bg-slate-900 border-slate-800 shadow">
                <div class="card-header bg-slate-800 border-slate-700 py-3 fw-bold text-white">
                    <i class="bi bi-database me-2 text-purple-400"></i>BugCoreBT Database Tables
                </div>
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between py-1 border-bottom border-slate-800 small text-slate-300">
                        <span><i class="bi bi-table text-slate-500 me-2"></i>bugcore_project_table</span>
                        <span class="badge bg-slate-800 text-slate-300">@ViewBag.TotalProjects</span>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom border-slate-800 small text-slate-300">
                        <span><i class="bi bi-table text-slate-500 me-2"></i>bugcore_user_table</span>
                        <span class="badge bg-slate-800 text-slate-300">@ViewBag.TotalUsers</span>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom border-slate-800 small text-slate-300">
                        <span><i class="bi bi-table text-slate-500 me-2"></i>bugcore_bug_table</span>
                        <span class="badge bg-slate-800 text-slate-300">@ViewBag.TotalIssues</span>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom border-slate-800 small text-slate-300">
                        <span><i class="bi bi-table text-slate-500 me-2"></i>bugcore_bugnote_table</span>
                        <span class="badge bg-slate-800 text-slate-300">@ViewBag.TotalNotes</span>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom border-slate-800 small text-slate-300">
                        <span><i class="bi bi-table text-slate-500 me-2"></i>bugcore_category_table</span>
                        <span class="badge bg-slate-800 text-slate-300">@ViewBag.TotalCategories</span>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom border-slate-800 small text-slate-300">
                        <span><i class="bi bi-table text-slate-500 me-2"></i>bugcore_project_version_table</span>
                        <span class="badge bg-slate-800 text-slate-300">@ViewBag.TotalVersions</span>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom border-slate-800 small text-slate-300">
                        <span><i class="bi bi-table text-slate-500 me-2"></i>bugcore_custom_field_table</span>
                        <span class="badge bg-slate-800 text-slate-300">@ViewBag.TotalCustomFields</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
