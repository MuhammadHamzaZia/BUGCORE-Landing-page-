@model BugCore.Web.ViewModels.Projects.VersionEditViewModel
@{
    ViewData["Title"] = $"Edit Version - {Model.Version}";
    var projectName = Model.Project != null ? Model.Project.Name : "Project";
}

<div class="container-fluid py-2" style="max-width: 800px;">
    <!-- Breadcrumb / Header -->
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <div>
            <h4 class="fw-bold mb-0 text-dark">
                <i class="bi bi-git me-2 text-primary"></i>Edit Version
            </h4>
            <span class="text-muted small">
                Project: <strong>@projectName</strong>
            </span>
        </div>
        <div>
            <a href="/Project/Edit/@Model.ProjectId#versions" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Project
            </a>
        </div>
    </div>

    <!-- Edit Version Form (Mirroring manage_proj_ver_edit_page.php) -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom">
            <h6 class="mb-0 fw-bold text-dark">
                <i class="bi bi-sliders text-primary me-2"></i> Version Details
            </h6>
        </div>
        <div class="card-body p-4">
            <form asp-controller="Version" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ProjectId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                <!-- Version String -->
                <div class="row mb-3 align-items-center">
                    <label asp-for="Version" class="col-sm-3 col-form-label fw-semibold text-secondary">
                        Version <span class="text-danger">*</span>
                    </label>
                    <div class="col-sm-9">
                        <input asp-for="Version" class="form-control" required maxlength="64" />
                        <span asp-validation-for="Version" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Date Order -->
                <div class="row mb-3 align-items-center">
                    <label asp-for="DateOrder" class="col-sm-3 col-form-label fw-semibold text-secondary">
                        Date Order / Target
                    </label>
                    <div class="col-sm-9">
                        <input asp-for="DateOrder" type="date" class="form-control" 
                               value="@(Model.DateOrder.HasValue ? Model.DateOrder.Value.ToString("yyyy-MM-dd") : "")" />
                        <span class="text-muted small">Used to chronological order releases and roadmaps</span>
                    </div>
                </div>

                <!-- Description -->
                <div class="row mb-3">
                    <label asp-for="Description" class="col-sm-3 col-form-label fw-semibold text-secondary">
                        Description
                    </label>
                    <div class="col-sm-9">
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Release highlights, milestone goals, or notes"></textarea>
                    </div>
                </div>

                <!-- Released Checkbox -->
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-3 col-form-label fw-semibold text-secondary">Released</label>
                    <div class="col-sm-9">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="Released" role="switch" />
                            <label class="form-check-label text-muted small" asp-for="Released">
                                Mark this milestone version as officially released to users
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Obsolete Checkbox -->
                <div class="row mb-4 align-items-center">
                    <label class="col-sm-3 col-form-label fw-semibold text-secondary">Obsolete</label>
                    <div class="col-sm-9">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="Obsolete" role="switch" />
                            <label class="form-check-label text-muted small" asp-for="Obsolete">
                                Mark version as obsolete and hide it from future bug reporting selections
                            </label>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Action Buttons -->
                <div class="d-flex justify-content-between align-items-center">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Update Version
                    </button>
                    <a href="/Project/Edit/@Model.ProjectId#versions" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
