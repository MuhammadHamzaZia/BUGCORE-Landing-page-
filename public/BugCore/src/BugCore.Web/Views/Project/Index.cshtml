@model BugCore.Web.ViewModels.Projects.ProjectListViewModel
@using BugCore.Core.Enums
@{
    ViewData["Title"] = "Manage Projects";

    string GetStatusText(int status) => status switch
    {
        10 => "development",
        30 => "release",
        50 => "stable",
        70 => "obsolete",
        _ => "development"
    };

    string GetStatusBadgeClass(int status) => status switch
    {
        10 => "bg-info text-dark",
        30 => "bg-primary text-white",
        50 => "bg-success text-white",
        70 => "bg-secondary text-white",
        _ => "bg-light text-dark"
    };
}

<div class="container-fluid py-2">
    <!-- Breadcrumb and Actions Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <div>
            <h4 class="fw-bold mb-0 text-dark">
                <i class="bi bi-puzzle me-2 text-primary"></i>Manage Projects
            </h4>
            <span class="text-muted small">Configure project hierarchy, subprojects, global categories, versions, and accounts</span>
        </div>
        <div>
            @if (Model.CanCreateProject)
            {
                <a asp-action="Create" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i> Create New Project
                </a>
            }
        </div>
    </div>

    <!-- Alert / Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show small py-2" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show small py-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Projects Hierarchy Table Widget -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-dark">
                <i class="bi bi-diagram-3 text-primary me-2"></i> Projects Hierarchy
            </h6>
            <span class="badge bg-light text-secondary border">@Model.HierarchicalProjects.Count() Total Projects</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th style="min-width: 260px;">Name</th>
                        <th>Status</th>
                        <th class="text-center">Enabled</th>
                        <th>View Status</th>
                        <th>Description</th>
                        <th class="text-center" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.HierarchicalProjects.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-folder-x fs-2 d-block mb-2 text-secondary"></i>
                                No projects have been created yet.
                                @if (Model.CanCreateProject)
                                {
                                    <div class="mt-2">
                                        <a asp-action="Create" class="btn btn-sm btn-outline-primary">Create the first project</a>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.HierarchicalProjects)
                    {
                        var proj = item.Project;
                        var level = item.Level;
                        <tr>
                            <td>
                                <div style="padding-left: @(level * 24)px;" class="d-flex align-items-center">
                                    @if (level > 0)
                                    {
                                        <span class="text-muted me-2 font-monospace fw-bold">&raquo;</span>
                                    }
                                    <a asp-action="Edit" asp-route-id="@proj.Id" class="fw-bold text-decoration-none text-dark hover-primary">
                                        @proj.Name
                                    </a>
                                </div>
                            </td>
                            <td>
                                <span class="badge @GetStatusBadgeClass(proj.Status)">
                                    @GetStatusText(proj.Status)
                                </span>
                            </td>
                            <td class="text-center">
                                @if (proj.Enabled)
                                {
                                    <i class="bi bi-check-circle-fill text-success" title="Enabled"></i>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle-fill text-danger" title="Disabled"></i>
                                }
                            </td>
                            <td>
                                <span class="badge @(proj.ViewState == ProjectViewState.Public ? "bg-success-subtle text-success border border-success-subtle" : "bg-warning-subtle text-dark border border-warning-subtle")">
                                    @proj.ViewState
                                </span>
                            </td>
                            <td class="text-muted">
                                @(string.IsNullOrWhiteSpace(proj.Description) ? "—" : proj.Description)
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@proj.Id" class="btn btn-outline-secondary" title="Manage Project">
                                        <i class="bi bi-gear me-1"></i> Edit
                                    </a>
                                    @if (Model.CanManageSite)
                                    {
                                        <a asp-action="Delete" asp-route-id="@proj.Id" class="btn btn-outline-danger" title="Delete Project">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Global Categories Widget (Mirroring manage_proj_page.php #categories) -->
    <div id="categories" class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-dark">
                <i class="bi bi-tags text-primary me-2"></i> Global Categories
            </h6>
            <span class="text-muted small">Categories inherited by all projects with 'Inherit Global Categories' enabled</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Category</th>
                        <th class="text-center" style="width: 100px;">Status</th>
                        <th>Assigned To</th>
                        @if (Model.CanManageSite)
                        {
                            <th class="text-center" style="width: 140px;">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.GlobalCategories.Any())
                    {
                        <tr>
                            <td colspan="@(Model.CanManageSite ? 4 : 3)" class="text-center py-4 text-muted">
                                No global categories defined.
                            </td>
                        </tr>
                    }
                    @foreach (var cat in Model.GlobalCategories)
                    {
                        <tr>
                            <td class="fw-semibold text-dark">
                                @cat.Name
                            </td>
                            <td class="text-center">
                                @if (cat.Status == 0)
                                {
                                    <span class="badge bg-success-subtle text-success">Enabled</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Obsolete</span>
                                }
                            </td>
                            <td>
                                @(cat.DefaultAssignee != null ? cat.DefaultAssignee.UserName : "—")
                            </td>
                            @if (Model.CanManageSite)
                            {
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-controller="Category" asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-outline-secondary btn-sm" title="Edit Category">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </a>
                                        <form asp-controller="Category" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete global category \'@cat.Name\'?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@cat.Id" />
                                            <input type="hidden" name="projectId" value="" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete Category">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.CanManageSite)
        {
            <div class="card-footer bg-light py-3 border-top">
                <form asp-controller="Category" asp-action="Add" method="post" class="row g-2 align-items-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectId" value="" />
                    <div class="col-auto">
                        <label class="col-form-label small fw-semibold">New Category:</label>
                    </div>
                    <div class="col-sm-4 col-md-3">
                        <input type="text" name="name" class="form-control form-control-sm" placeholder="Category Name" required maxlength="128" />
                    </div>
                    <div class="col-sm-4 col-md-3">
                        <select name="defaultAssigneeId" class="form-select form-select-sm">
                            <option value="">(Assignee: None)</option>
                            @foreach (var user in Model.AllUsers)
                            {
                                <option value="@user.Id">@user.UserName (@user.Email)</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto d-flex gap-2">
                        <button type="submit" class="btn btn-sm btn-primary">
                            <i class="bi bi-plus-lg me-1"></i> Add Category
                        </button>
                        <button type="submit" name="addAndEdit" value="true" class="btn btn-sm btn-outline-primary">
                            Add and Edit Category
                        </button>
                    </div>
                </form>
            </div>
        }
    </div>
</div>
