@model BugCore.Web.ViewModels.Projects.ProjectDetailsViewModel
@using BugCore.Core.Enums
@{
    ViewData["Title"] = $"Manage Project - {Model.Project.Name}";

    string GetStatusText(int status) => status switch
    {
        10 => "development",
        30 => "release",
        50 => "stable",
        70 => "obsolete",
        _ => "development"
    };

    string GetStatusBadgeClass(int status) => status switch
    {
        10 => "bg-info text-dark",
        30 => "bg-primary text-white",
        50 => "bg-success text-white",
        70 => "bg-secondary text-white",
        _ => "bg-light text-dark"
    };
}

<div class="container-fluid py-2">
    <!-- Header / Navigation Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary py-0 px-2" title="All Projects">
                    <i class="bi bi-chevron-left"></i>
                </a>
                <h4 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-folder2-open me-2 text-primary"></i>@Model.Project.Name
                </h4>
                <span class="badge @(Model.Project.ViewState == ProjectViewState.Public ? "bg-success" : "bg-dark")">
                    @Model.Project.ViewState
                </span>
                <span class="badge @GetStatusBadgeClass(Model.Project.Status)">
                    @GetStatusText(Model.Project.Status)
                </span>
            </div>
            <span class="text-muted small ms-4 ps-2">Manage settings, subprojects, categories, versions, custom fields, and accounts</span>
        </div>
        <div class="d-flex gap-2">
            <a href="#subprojects" class="btn btn-sm btn-outline-secondary">Subprojects</a>
            <a href="#categories" class="btn btn-sm btn-outline-secondary">Categories</a>
            <a href="#versions" class="btn btn-sm btn-outline-secondary">Versions</a>
            <a href="#customfields" class="btn btn-sm btn-outline-secondary">Custom Fields</a>
            <a href="#project-users" class="btn btn-sm btn-outline-secondary">Users</a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show small py-2" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show small py-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 1. EDIT PROJECT PROPERTIES WIDGET -->
    <div id="project-properties" class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 border-bottom">
            <h6 class="mb-0 fw-bold text-dark">
                <i class="bi bi-sliders text-primary me-2"></i> Project Properties
            </h6>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.Project.Id" />

                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-semibold text-secondary">
                        Project Name <span class="text-danger">*</span>
                    </label>
                    <div class="col-sm-10">
                        <input type="text" name="Name" class="form-control" value="@Model.Project.Name" required maxlength="128" />
                    </div>
                </div>

                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-semibold text-secondary">Status</label>
                    <div class="col-sm-4">
                        <select name="Status" class="form-select">
                            <option value="10" selected="@(Model.Project.Status == 10)">development</option>
                            <option value="30" selected="@(Model.Project.Status == 30)">release</option>
                            <option value="50" selected="@(Model.Project.Status == 50)">stable</option>
                            <option value="70" selected="@(Model.Project.Status == 70)">obsolete</option>
                        </select>
                    </div>
                    <label class="col-sm-2 col-form-label fw-semibold text-secondary">View Status</label>
                    <div class="col-sm-4">
                        <select name="ViewState" class="form-select">
                            <option value="@ProjectViewState.Public" selected="@(Model.Project.ViewState == ProjectViewState.Public)">public</option>
                            <option value="@ProjectViewState.Private" selected="@(Model.Project.ViewState == ProjectViewState.Private)">private</option>
                        </select>
                    </div>
                </div>

                <div class="row mb-3 align-items-center">
                    <label class="col-sm-2 col-form-label fw-semibold text-secondary">Enabled</label>
                    <div class="col-sm-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="Enabled" value="true" role="switch" checked="@Model.Project.Enabled" />
                            <label class="form-check-label text-muted small">Project is enabled</label>
                        </div>
                    </div>
                    <label class="col-sm-2 col-form-label fw-semibold text-secondary">Inherit Categories</label>
                    <div class="col-sm-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="InheritCategories" value="true" role="switch" checked="@Model.Project.InheritCategories" />
                            <label class="form-check-label text-muted small">Inherit global categories</label>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label fw-semibold text-secondary">Description</label>
                    <div class="col-sm-10">
                        <textarea name="Description" class="form-control" rows="3">@Model.Project.Description</textarea>
                    </div>
                </div>

                <!-- SLACK ROUTING PANEL (Channel-to-Project Routing) -->
                <div class="card bg-slate-900 border-slate-700 my-4 shadow-sm">
                    <div class="card-header bg-slate-800 border-slate-700 py-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-slack text-emerald-400 fs-5"></i>
                            <div>
                                <h6 class="fw-bold text-white mb-0">Slack Channel Routing</h6>
                                <span class="text-slate-400 small">Route new bugs & defect cards exclusively to this team's dedicated Slack channel to eliminate alert fatigue.</span>
                            </div>
                        </div>
                        <a asp-controller="Slack" asp-action="Index" class="btn btn-sm btn-outline-light" target="_blank" title="Open Slack ChatOps Hub">
                            <i class="bi bi-sliders me-1"></i> Slack Hub & Simulator
                        </a>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-slate-300">Dedicated Slack Channel</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-slate-800 border-slate-700 text-slate-400"><i class="bi bi-hash"></i></span>
                                    <input type="text" name="SlackChannelName" class="form-control bg-slate-900 border-slate-700 text-slate-100" 
                                           value="@(string.IsNullOrEmpty(Model.Project.SlackChannelName) ? "#bugs-triage" : Model.Project.SlackChannelName)" 
                                           placeholder="e.g. #eng-mobile-app" />
                                </div>
                                <div class="form-text text-slate-400 small">Select or type the channel name where developers receive notifications.</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-slate-300">Slack Channel ID</label>
                                <input type="text" name="SlackChannelId" class="form-control bg-slate-900 border-slate-700 text-slate-100" 
                                       value="@(string.IsNullOrEmpty(Model.Project.SlackChannelId) ? "C08TRIAGE00" : Model.Project.SlackChannelId)" 
                                       placeholder="e.g. C08MOBILE102" />
                                <div class="form-text text-slate-400 small">Slack Channel ID for Slack API event listening and thread triage.</div>
                            </div>

                            <div class="col-md-9">
                                <label class="form-label fw-semibold text-slate-300">Optional Webhook URL</label>
                                <input type="url" name="SlackWebhookUrl" class="form-control bg-slate-900 border-slate-700 text-slate-100" 
                                       value="@Model.Project.SlackWebhookUrl" 
                                       placeholder="https://hooks.slack.com/services/T0000/B0000/XXXXXX" />
                            </div>

                            <div class="col-md-3 d-flex align-items-end">
                                <div class="form-check form-switch pb-2">
                                    <input class="form-check-input" type="checkbox" name="SlackNotificationsEnabled" value="true" role="switch" @(Model.Project.SlackNotificationsEnabled ? "checked" : "") />
                                    <label class="form-check-label text-slate-200 fw-semibold ms-2">Enable Routing</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Update Project Settings
                    </button>
                    <a asp-action="Delete" asp-route-id="@Model.Project.Id" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-trash me-1"></i> Delete Project
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- 2. SUBPROJECTS WIDGET (Mirroring manage_proj_edit_page.php Subprojects) -->
    <div id="subprojects" class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-dark">
                <i class="bi bi-diagram-2 text-primary me-2"></i> Subprojects
            </h6>
            <a asp-action="Create" asp-route-parentProjectId="@Model.Project.Id" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-plus-lg me-1"></i> Create New Subproject
            </a>
        </div>

        @if (Model.EligibleSubprojects.Any())
        {
            <div class="p-3 bg-light border-bottom">
                <form asp-action="AddSubproject" method="post" class="row g-2 align-items-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="parentId" value="@Model.Project.Id" />
                    <div class="col-auto">
                        <span class="small fw-semibold text-secondary">Attach Existing Project:</span>
                    </div>
                    <div class="col-sm-4">
                        <select name="childId" class="form-select form-select-sm" required>
                            <option value="">-- Select Project --</option>
                            @foreach (var eligible in Model.EligibleSubprojects)
                            {
                                <option value="@eligible.Id">@eligible.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <div class="form-check form-check-inline small">
                            <input class="form-check-input" type="checkbox" name="inherit" value="true" id="subprojInheritCheck" checked />
                            <label class="form-check-label" for="subprojInheritCheck">Inherit Parent</label>
                        </div>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-sm btn-primary">
                            <i class="bi bi-link-45deg me-1"></i> Add as Subproject
                        </button>
                    </div>
                </form>
            </div>
        }

        <form asp-action="UpdateSubprojectChildren" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="projectId" value="@Model.Project.Id" />

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Subproject Name</th>
                            <th>Status</th>
                            <th class="text-center">Enabled</th>
                            <th class="text-center" style="width: 140px;">Inherit Parent</th>
                            <th>View Status</th>
                            <th>Description</th>
                            <th class="text-center" style="width: 120px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Subprojects.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    No subprojects attached to this project.
                                </td>
                            </tr>
                        }
                        @foreach (var sub in Model.Subprojects)
                        {
                            var child = sub.ChildProject;
                            <tr>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@child.Id" class="fw-bold text-decoration-none text-dark">
                                        <i class="bi bi-folder-fill text-warning me-1"></i> @child.Name
                                    </a>
                                </td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(child.Status)">
                                        @GetStatusText(child.Status)
                                    </span>
                                </td>
                                <td class="text-center">
                                    @(child.Enabled ? "Enabled" : "Disabled")
                                </td>
                                <td class="text-center">
                                    <div class="form-check form-check-inline m-0">
                                        <input class="form-check-input" type="checkbox" name="inherit_child_@(child.Id)" value="true" checked="@sub.InheritChild" />
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @(child.ViewState == ProjectViewState.Public ? "bg-success-subtle text-success" : "bg-dark-subtle text-dark")">
                                        @child.ViewState
                                    </span>
                                </td>
                                <td class="text-muted">@(string.IsNullOrWhiteSpace(child.Description) ? "—" : child.Description)</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@child.Id" class="btn btn-outline-secondary" title="Edit">
                                            <i class="bi bi-gear"></i>
                                        </a>
                                        <form asp-action="RemoveSubproject" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="parentId" value="@Model.Project.Id" />
                                            <input type="hidden" name="childId" value="@child.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Unlink" 
                                                    onclick="return confirm('Unlink subproject \'@child.Name\' from \'@Model.Project.Name\'?');">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.Subprojects.Any())
            {
                <div class="card-footer bg-white py-2 border-top">
                    <button type="submit" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-check2-all me-1"></i> Update Subproject Inheritance
                    </button>
                </div>
            }
        </form>
    </div>

    <!-- 3. CATEGORIES WIDGET (Mirroring manage_proj_edit_page.php Categories) -->
    <div id="categories" class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-dark">
                <i class="bi bi-tags text-primary me-2"></i> Categories
            </h6>
            <span class="text-muted small">Project and inherited categories for classifying issues</span>
        </div>

        <!-- Copy Categories Toolbar -->
        @if (Model.OtherProjects.Any())
        {
            <div class="p-3 bg-light border-bottom">
                <form asp-controller="Category" asp-action="Copy" method="post" class="row g-2 align-items-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectId" value="@Model.Project.Id" />
                    <div class="col-auto">
                        <span class="small fw-semibold text-secondary">Copy Categories:</span>
                    </div>
                    <div class="col-sm-3">
                        <select name="otherProjectId" class="form-select form-select-sm" required>
                            <option value="0">[All Projects / Global]</option>
                            @foreach (var other in Model.OtherProjects)
                            {
                                <option value="@other.Id">@other.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <div class="form-check form-check-inline small">
                            <input class="form-check-input" type="checkbox" name="excludeInherited" value="true" id="catExcludeCheck" />
                            <label class="form-check-label" for="catExcludeCheck">Exclude Inherited</label>
                        </div>
                    </div>
                    <div class="col-auto d-flex gap-2">
                        <button type="submit" name="copyFrom" value="true" class="btn btn-sm btn-outline-secondary">
                            Copy From
                        </button>
                        <button type="submit" name="copyTo" value="true" class="btn btn-sm btn-outline-secondary">
                            Copy To
                        </button>
                    </div>
                </form>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Category</th>
                        <th class="text-center" style="width: 120px;">Status</th>
                        <th>Assigned To</th>
                        <th class="text-center" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Categories.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                No categories defined for this project.
                            </td>
                        </tr>
                    }
                    @foreach (var cat in Model.Categories)
                    {
                        bool isInherited = cat.ProjectId != Model.Project.Id;
                        <tr>
                            <td>
                                <strong class="text-dark">@cat.Name</strong>
                                @if (isInherited)
                                {
                                    <span class="badge bg-light text-muted border ms-2">inherited</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (cat.Status == 0)
                                {
                                    <span class="badge bg-success-subtle text-success">Enabled</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Obsolete</span>
                                }
                            </td>
                            <td>
                                @(cat.DefaultAssignee != null ? cat.DefaultAssignee.UserName : "—")
                            </td>
                            <td class="text-center">
                                @if (!isInherited)
                                {
                                    <div class="btn-group btn-group-sm">
                                        <a asp-controller="Category" asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-outline-secondary btn-sm" title="Edit">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </a>
                                        <form asp-controller="Category" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete category \'@cat.Name\'?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@cat.Id" />
                                            <input type="hidden" name="projectId" value="@Model.Project.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic small">Global (Read-Only)</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Add Category Form -->
        <div class="card-footer bg-light py-3 border-top">
            <form asp-controller="Category" asp-action="Add" method="post" class="row g-2 align-items-center">
                @Html.AntiForgeryToken()
                <input type="hidden" name="projectId" value="@Model.Project.Id" />
                <div class="col-auto">
                    <label class="col-form-label small fw-semibold">New Category:</label>
                </div>
                <div class="col-sm-4 col-md-3">
                    <input type="text" name="name" class="form-control form-control-sm" placeholder="Category Name" required maxlength="128" />
                </div>
                <div class="col-sm-4 col-md-3">
                    <select name="defaultAssigneeId" class="form-select form-select-sm">
                        <option value="">(Assignee: None)</option>
                        @foreach (var user in Model.AssignedUsers.Select(pu => pu.User).Concat(Model.UnassignedUsers).DistinctBy(u => u.Id))
                        {
                            <option value="@user.Id">@user.UserName</option>
                        }
                    </select>
                </div>
                <div class="col-auto d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-plus-lg me-1"></i> Add Category
                    </button>
                    <button type="submit" name="addAndEdit" value="true" class="btn btn-sm btn-outline-primary">
                        Add and Edit Category
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 4. VERSIONS WIDGET (Mirroring manage_proj_edit_page.php Versions) -->
    <div id="versions" class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-dark">
                <i class="bi bi-git text-primary me-2"></i> Versions
            </h6>
            <span class="text-muted small">Release tracking milestones and targets</span>
        </div>

        <!-- Copy Versions Toolbar -->
        @if (Model.OtherProjects.Any())
        {
            <div class="p-3 bg-light border-bottom">
                <form asp-controller="Version" asp-action="Copy" method="post" class="row g-2 align-items-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectId" value="@Model.Project.Id" />
                    <div class="col-auto">
                        <span class="small fw-semibold text-secondary">Copy Versions:</span>
                    </div>
                    <div class="col-sm-3">
                        <select name="otherProjectId" class="form-select form-select-sm" required>
                            <option value="">-- Select Project --</option>
                            @foreach (var other in Model.OtherProjects)
                            {
                                <option value="@other.Id">@other.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto d-flex gap-2">
                        <button type="submit" name="copyFrom" value="true" class="btn btn-sm btn-outline-secondary">
                            Copy From
                        </button>
                        <button type="submit" name="copyTo" value="true" class="btn btn-sm btn-outline-secondary">
                            Copy To
                        </button>
                    </div>
                </form>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Version</th>
                        <th class="text-center" style="width: 100px;">Released</th>
                        <th class="text-center" style="width: 100px;">Obsolete</th>
                        <th style="width: 160px;">Date Order</th>
                        <th>Description</th>
                        <th class="text-center" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Versions.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                No release versions configured for this project.
                            </td>
                        </tr>
                    }
                    @foreach (var v in Model.Versions)
                    {
                        <tr>
                            <td class="fw-bold text-dark">
                                @v.Version
                            </td>
                            <td class="text-center">
                                @if (v.Released)
                                {
                                    <span class="badge bg-success-subtle text-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted">No</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (v.Obsolete)
                                {
                                    <span class="badge bg-danger-subtle text-danger">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted">No</span>
                                }
                            </td>
                            <td class="text-muted">
                                @(v.DateOrder.HasValue ? v.DateOrder.Value.ToString("yyyy-MM-dd") : "—")
                            </td>
                            <td class="text-muted">
                                @(string.IsNullOrWhiteSpace(v.Description) ? "—" : v.Description)
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-controller="Version" asp-action="Edit" asp-route-id="@v.Id" class="btn btn-outline-secondary btn-sm" title="Edit">
                                        <i class="bi bi-pencil me-1"></i> Edit
                                    </a>
                                    <form asp-controller="Version" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete version \'@v.Version\'?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@v.Id" />
                                        <input type="hidden" name="projectId" value="@Model.Project.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Add Version Form -->
        <div class="card-footer bg-light py-3 border-top">
            <form asp-controller="Version" asp-action="Add" method="post" class="row g-2 align-items-center">
                @Html.AntiForgeryToken()
                <input type="hidden" name="projectId" value="@Model.Project.Id" />
                <div class="col-auto">
                    <label class="col-form-label small fw-semibold">New Version:</label>
                </div>
                <div class="col-sm-3 col-md-2">
                    <input type="text" name="version" class="form-control form-control-sm" placeholder="e.g. 1.2.0" required maxlength="64" />
                </div>
                <div class="col-sm-3 col-md-2">
                    <input type="date" name="dateOrder" class="form-control form-control-sm" title="Date Order" />
                </div>
                <div class="col-sm-3 col-md-3">
                    <input type="text" name="description" class="form-control form-control-sm" placeholder="Description / notes" />
                </div>
                <div class="col-auto d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-plus-lg me-1"></i> Add Version
                    </button>
                    <button type="submit" name="addAndEdit" value="true" class="btn btn-sm btn-outline-primary">
                        Add and Edit Version
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 5. CUSTOM FIELDS WIDGET (Mirroring manage_proj_edit_page.php Custom Fields) -->
    <div id="customfields" class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-dark">
                <i class="bi bi-input-cursor text-primary me-2"></i> Custom Fields
            </h6>
            <span class="text-muted small">Link and order custom fields for this project</span>
        </div>

        <!-- Copy Custom Fields Toolbar -->
        @if (Model.OtherProjects.Any())
        {
            <div class="p-3 bg-light border-bottom">
                <form asp-action="CopyCustomFields" method="post" class="row g-2 align-items-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectId" value="@Model.Project.Id" />
                    <div class="col-auto">
                        <span class="small fw-semibold text-secondary">Copy Custom Fields:</span>
                    </div>
                    <div class="col-sm-3">
                        <select name="otherProjectId" class="form-select form-select-sm" required>
                            <option value="">-- Select Project --</option>
                            @foreach (var other in Model.OtherProjects)
                            {
                                <option value="@other.Id">@other.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto d-flex gap-2">
                        <button type="submit" name="copyFrom" value="true" class="btn btn-sm btn-outline-secondary">
                            Copy From
                        </button>
                        <button type="submit" name="copyTo" value="true" class="btn btn-sm btn-outline-secondary">
                            Copy To
                        </button>
                    </div>
                </form>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Custom Field Name</th>
                        <th style="width: 140px;">Type</th>
                        <th style="width: 140px;">Sequence</th>
                        <th class="text-center" style="width: 120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.LinkedCustomFields.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                No custom fields currently linked to this project.
                            </td>
                        </tr>
                    }
                    @foreach (var link in Model.LinkedCustomFields)
                    {
                        var cf = link.CustomField;
                        <tr>
                            <td class="fw-bold text-dark">
                                @cf.Name
                            </td>
                            <td>
                                <span class="badge bg-light text-secondary border">@cf.Type</span>
                            </td>
                            <td>
                                <form asp-action="UpdateCustomFieldSequence" method="post" class="d-flex align-items-center gap-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="projectId" value="@Model.Project.Id" />
                                    <input type="hidden" name="fieldId" value="@cf.Id" />
                                    <input type="number" name="sequence" value="@link.Sequence" class="form-control form-control-sm text-center" style="width: 70px;" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary py-0 px-2" title="Update Sequence">
                                        <i class="bi bi-arrow-clockwise"></i>
                                    </button>
                                </form>
                            </td>
                            <td class="text-center">
                                <form asp-action="RemoveCustomField" method="post" onsubmit="return confirm('Unlink custom field \'@cf.Name\' from this project?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="projectId" value="@Model.Project.Id" />
                                    <input type="hidden" name="fieldId" value="@cf.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-x-circle me-1"></i> Unlink
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.AvailableCustomFields.Any())
        {
            <div class="card-footer bg-light py-3 border-top">
                <form asp-action="AddCustomField" method="post" class="row g-2 align-items-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectId" value="@Model.Project.Id" />
                    <div class="col-auto">
                        <label class="col-form-label small fw-semibold">Link Custom Field:</label>
                    </div>
                    <div class="col-sm-4">
                        <select name="fieldId" class="form-select form-select-sm" required>
                            <option value="">-- Choose Field to Link --</option>
                            @foreach (var f in Model.AvailableCustomFields)
                            {
                                <option value="@f.Id">@f.Name (@f.Type)</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-2">
                        <input type="number" name="sequence" class="form-control form-control-sm" placeholder="Sequence (0)" value="0" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-sm btn-primary">
                            <i class="bi bi-link-45deg me-1"></i> Add Existing Custom Field
                        </button>
                    </div>
                </form>
            </div>
        }
    </div>

    <!-- 6. PROJECT ACCOUNTS / USERS & BATCH ACL WIDGET (Mirroring manage_proj_edit_page.php Users & manage_proj_user_update.php) -->
    <div id="project-users" class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-dark">
                <i class="bi bi-people text-primary me-2"></i> Manage Accounts & Project User Permissions
            </h6>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.Project.Id" asp-route-showGlobalUsers="@(!Model.ShowGlobalUsers)" class="btn btn-sm btn-outline-secondary">
                    @(Model.ShowGlobalUsers ? "Hide Global Users" : "Show Users with Global Access")
                </a>
            </div>
        </div>

        <div class="p-3 border-bottom @(Model.Project.ViewState == ProjectViewState.Public ? "bg-light" : "bg-warning-subtle")">
            <div class="small">
                <i class="bi bi-info-circle-fill me-1 text-primary"></i>
                @if (Model.Project.ViewState == ProjectViewState.Public)
                {
                    <span><strong>Public Project:</strong> All users with adequate global access can access this project. Explicitly assigning a user here overrides their global access level for this project.</span>
                }
                else
                {
                    <span><strong>Private Project:</strong> Only administrators, managers, and users explicitly assigned in this table have access to view and manage issues in this project.</span>
                }
            </div>
        </div>

        <!-- Copy Users Toolbar -->
        @if (Model.OtherProjects.Any())
        {
            <div class="p-3 bg-light border-bottom">
                <form asp-controller="ProjectUser" asp-action="Copy" method="post" class="row g-2 align-items-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectId" value="@Model.Project.Id" />
                    <div class="col-auto">
                        <span class="small fw-semibold text-secondary">Copy Users:</span>
                    </div>
                    <div class="col-sm-3">
                        <select name="otherProjectId" class="form-select form-select-sm" required>
                            <option value="">-- Select Project --</option>
                            @foreach (var other in Model.OtherProjects)
                            {
                                <option value="@other.Id">@other.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto d-flex gap-2">
                        <button type="submit" name="copyFrom" value="true" class="btn btn-sm btn-outline-secondary">
                            Copy From
                        </button>
                        <button type="submit" name="copyTo" value="true" class="btn btn-sm btn-outline-secondary">
                            Copy To
                        </button>
                    </div>
                </form>
            </div>
        }

        <!-- Batch ACL Updates and Deletions Form -->
        <form asp-controller="ProjectUser" asp-action="UpdateUsers" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="projectId" value="@Model.Project.Id" />

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Username</th>
                            <th>Real Name / Email</th>
                            <th style="width: 200px;">Project Access Level</th>
                            <th class="text-center" style="width: 90px;">Remove</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.AssignedUsers.Any() && (!Model.ShowGlobalUsers || !Model.GlobalUsers.Any()))
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    No users explicitly assigned to this project.
                                </td>
                            </tr>
                        }
                        @foreach (var pu in Model.AssignedUsers)
                        {
                            var user = pu.User;
                            <tr>
                                <td>
                                    <strong class="text-dark">@user.UserName</strong>
                                </td>
                                <td class="text-muted">
                                    @(string.IsNullOrWhiteSpace(user.RealName) ? user.Email : $"{user.RealName} ({user.Email})")
                                </td>
                                <td>
                                    <select name="user_access_level[@user.Id]" class="form-select form-select-sm">
                                        <option value="10" selected="@(pu.AccessLevel == AccessLevel.Viewer)">Viewer</option>
                                        <option value="25" selected="@(pu.AccessLevel == AccessLevel.Reporter)">Reporter</option>
                                        <option value="40" selected="@(pu.AccessLevel == AccessLevel.Updater)">Updater</option>
                                        <option value="55" selected="@(pu.AccessLevel == AccessLevel.Developer)">Developer</option>
                                        <option value="70" selected="@(pu.AccessLevel == AccessLevel.Manager)">Manager</option>
                                        <option value="90" selected="@(pu.AccessLevel == AccessLevel.Administrator)">Administrator</option>
                                    </select>
                                </td>
                                <td class="text-center">
                                    <div class="form-check form-check-inline m-0">
                                        <input class="form-check-input" type="checkbox" name="user_access_delete" value="@user.Id" title="Mark for removal" />
                                    </div>
                                </td>
                            </tr>
                        }

                        @if (Model.ShowGlobalUsers)
                        {
                            <tr class="table-secondary">
                                <td colspan="4" class="fw-bold small py-1">
                                    <i class="bi bi-globe me-1"></i> Users With Global Access (Not Explicitly Assigned)
                                </td>
                            </tr>
                            @foreach (var gu in Model.GlobalUsers)
                            {
                                <tr class="text-muted">
                                    <td>@gu.UserName <span class="badge bg-light text-secondary border ms-1">global</span></td>
                                    <td>@gu.RealName (@gu.Email)</td>
                                    <td>Global: @gu.GlobalAccessLevel</td>
                                    <td class="text-center">—</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-white py-3 border-top d-flex justify-content-between align-items-center">
                <button type="submit" class="btn btn-primary btn-sm px-3">
                    <i class="bi bi-check2-circle me-1"></i> Apply Changes
                </button>
                @if (Model.AssignedUsers.Any())
                {
                    <button type="submit" asp-controller="ProjectUser" asp-action="RemoveAll"
                            formmethod="post"
                            formaction="/ProjectUser/RemoveAll?projectId=@Model.Project.Id"
                            class="btn btn-outline-danger btn-sm"
                            onclick="return confirm('Are you sure you want to remove ALL explicitly assigned users from \'@Model.Project.Name\'?');">
                        <i class="bi bi-person-x me-1"></i> Remove All Users
                    </button>
                }
            </div>
        </form>

        <!-- Add Users To Project Form -->
        @if (Model.UnassignedUsers.Any())
        {
            <div class="card-footer bg-light py-3 border-top">
                <form asp-controller="ProjectUser" asp-action="Add" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectId" value="@Model.Project.Id" />
                    <div class="col-md-5">
                        <label class="form-label small fw-semibold">Add Unassigned Users:</label>
                        <select name="userIds" multiple class="form-select form-select-sm" size="4" required>
                            @foreach (var u in Model.UnassignedUsers)
                            {
                                <option value="@u.Id">@u.UserName (@(string.IsNullOrWhiteSpace(u.RealName) ? u.Email : u.RealName))</option>
                            }
                        </select>
                        <span class="text-muted" style="font-size: 0.75rem;">Hold Ctrl / Cmd to select multiple users</span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Access Level:</label>
                        <select name="accessLevel" class="form-select form-select-sm">
                            <option value="10">Viewer</option>
                            <option value="25" selected>Reporter</option>
                            <option value="40">Updater</option>
                            <option value="55">Developer</option>
                            <option value="70">Manager</option>
                            <option value="90">Administrator</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-sm btn-primary w-100">
                            <i class="bi bi-person-plus-fill me-1"></i> Add User
                        </button>
                    </div>
                </form>
            </div>
        }
    </div>
</div>
