@model BugCore.Core.Entities.Project
@{
    ViewData["Title"] = "Confirm Project Deletion";
}

<div class="container-fluid py-4" style="max-width: 680px;">
    <div class="card shadow border-danger">
        <div class="card-header bg-danger text-white py-3">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Project Deletion
            </h5>
        </div>
        <div class="card-body p-4">
            <p class="lead text-dark">
                Are you sure you want to permanently delete the project <strong>@Model.Name</strong>?
            </p>
            <div class="alert alert-warning small">
                <i class="bi bi-info-circle me-1"></i>
                <strong>Warning:</strong> Deleting this project will remove all associated project-specific categories, release versions, user assignments, subproject hierarchy associations, and custom field linkages.
            </div>

            <dl class="row small mb-4">
                <dt class="col-sm-4 text-secondary">Project Name:</dt>
                <dd class="col-sm-8 fw-semibold">@Model.Name</dd>

                <dt class="col-sm-4 text-secondary">Status:</dt>
                <dd class="col-sm-8">@(Model.Status == 10 ? "Development" : Model.Status == 30 ? "Release" : Model.Status == 50 ? "Stable" : "Obsolete")</dd>

                <dt class="col-sm-4 text-secondary">Visibility:</dt>
                <dd class="col-sm-8">@Model.ViewState</dd>
            </dl>

            <form asp-action="DeleteConfirmed" method="post" class="d-flex justify-content-end gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash-fill me-1"></i> Delete Project
                </button>
            </form>
        </div>
    </div>
</div>
